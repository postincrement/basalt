%name-prefix "MBASIC_" 
%define parse.error verbose

%{

#include <iostream>
#include <string>
#include <sstream>
#include <memory>
using namespace std;

#include "common.h"
#include "basalt.h"

#define YYDEBUG 1

extern void MBASIC_SetRemMode();

static void AddExpr(AST::Expr * expr)
{
}

%}

%union {
  char          cval;
  unsigned int  uval;
  int           ival;
  std::string * sval;

  AST::Expr *     expr;
  AST::ExprList * exprlist;

  SingleFloat * sfloat;
  DoubleFloat * dfloat;

  AST::VarRef * varref;

/*
  UnsignedList * ulist;
  Variable             * varval;
  AST::VariableDefExpr * vardef;
  AST::VariableRefExpr * varref;

  AST::Expr     * expr;
  AST::ExprList * exprlist;
*/  
}

%token EOL_TOKEN
%token EOF_TOKEN

// operators
%token GREATERTHANEQUAL
%token LESSTHANEQUAL
%token NOT_EQUAL
%token AND_TOKEN

// functions
%token CHR_TOKEN
%token INT_TOKEN
%token LEFT_TOKEN 
%token MID_TOKEN
%token RIGHT_TOKEN
%token SQR_TOKEN
%token STR_TOKEN
%token TAB_TOKEN

// commands
%token CLEAR_TOKEN
%token DEF_TOKEN
%token DIM_TOKEN
%token ELSE_TOKEN
%token END_TOKEN
%token FOR_TOKEN
%token IF_TOKEN
%token GOSUB_TOKEN
%token GOTO_TOKEN
%token INPUT_TOKEN
%token LET_TOKEN
%token NEXT_TOKEN
%token OR_TOKEN
%token ON_TOKEN
%token PRINT_TOKEN
%token REM_TOKEN
%token RETURN_TOKEN
%token RUN_TOKEN 
%token STEP_TOKEN
%token SYSTEM_TOKEN
%token STOP_TOKEN
%token THEN_TOKEN
%token TO_TOKEN
%token USING_TOKEN
%token WIDTH_TOKEN

// other lexemes
%token <sval>   IDENTIFIER QUOTED_STRING DEF_INTEGER
%token <sval>   INTEGER_VARNAME STRING_VARNAME SINGLE_VARNAME DOUBLE_VARNAME
%token <ival>   INTEGER  
%token <dfloat> DOUBLE 
%token <sfloat> SINGLE

// rules
%type <exprlist>    line opt_statement_list statement_list
 
%type <expr>        statement

%type <expr>    DIM_statement dim_var_list

%type <expr>    LET_statement assign_expression 

%type <expr>    FOR_statement

%type <expr>    GOTO_statement

%type <expr>     PRINT_statement 
%type <exprlist> print_expression_list 
%type <expr>     print_expression

%type <expr>        WIDTH_statement

%type <expr>        AND_expression NOT_expression compare_expression ADD_expression
%type <expr>        MULT_expression NEGATE_expression POWER_expression subexpression

%type <sval>        opt_line_number line_number
%type <expr>        expression const_expr value array_or_func_arg 
%type <ival>        integer

%type <varref>     var_ref var_name

%%

file:     /* empty */
          | file line
          ;

/*********************************************************F

 line              

 *********************************************************/ 

line:     opt_line_number 
              {
                AST::g_program.Append(
                  new AST::SourceLine(
                      g_lineNumber, 
                      g_application.GetCurrentLine())
                );
              }
            opt_statement_list eol
            {
              if ($1 != nullptr) {
                AST::g_program.Append(
                  new AST::LineNumber(*$1)
                );
                delete $1;
              }
              AST::g_program.Append($3);
            }
          ;

opt_line_number: /* empty */
                    { 
                      $$ = nullptr;
                    }
                 | line_number
                    { 
                      $$ = $1;
                    }
                 ;

line_number:    DEF_INTEGER
                    {
                      stringstream strm;
                      strm << *($1);
                      $$ = new std::string(strm.str());
                    }
                 ; 

integer:    INTEGER
              {
                $$ = $1;
              }
            ;                 

opt_statement_list : /* empty */
                      {
                        $$ = nullptr;
                      }
                   | statement_list
                      {
                        $$ = $1;
                      }
                   ;

statement_list : statement
                  {
                    $$ = new AST::ExprList();
                    $$->Append($1);
                  }   
               | statement_list ':' statement
                  {
                    $1->Append($3);
                    $$ = $1;
                  }   
               ;

statement:     CLEAR_statement
                  {
                    $$ = nullptr;
                  }
               | DEF_statement
                  {
                    $$ = nullptr;
                  }   
               | DIM_statement
                  {
                    $$ = $1;
                  }   
               | END_statement
                  {
                    $$ = nullptr;
                  }   
               | FOR_statement
                  {
                    $$ = $1;
                  }
               | GOTO_statement
                  {
                    $$ = $1;
                  }
               | GOSUB_statement
                  {
                    $$ = nullptr;
                  }
               | IF_statement
                  {
                    $$ = nullptr;
                  }
               | INPUT_statement
                  {
                    $$ = nullptr;
                  }
               | LET_statement
                  {
                    $$ = $1;
                  }
               | NEXT_statement
                  {
                    $$ = nullptr;
                  }
               | ON_statement
                  {
                    $$ = nullptr;
                  }   
               | PRINT_statement 
                  {
                    $$ = $1;
                  }
               | REM_statement
                  {
                    $$ = nullptr;
                  }
               | RUN_statement
                  {
                    $$ = nullptr;
                  }
               | RETURN_statement
                  {
                    $$ = nullptr;
                  }
               | STOP_statement
                  {
                    $$ = nullptr;
                  }
               | SYSTEM_statement
                  {
                    $$ = nullptr;
                  }
               | WIDTH_statement
                  {
                    $$ = nullptr;
                  }
               | error /* bison error handler */   
                  {
                    $$ = nullptr;
                  }
               ;

eol:    EOL_TOKEN
        | EOF_TOKEN
          { return 0; }  // yes, this is a return!
        ;               

/********************************************************* 

  CLEAR

 *********************************************************/ 

CLEAR_statement: CLEAR_TOKEN expression
                 ;

/********************************************************* 

  DEF

 *********************************************************/ 

DEF_statement:  DEF_TOKEN IDENTIFIER opt_def_args '=' expression 
                ;

opt_def_args: /* empty */
              | '(' def_arg_list ')'
              ;

def_arg_list: IDENTIFIER 
              | def_arg_list ',' IDENTIFIER
              ;              

/********************************************************* 

  DIM

 *********************************************************/ 

DIM_statement:  DIM_TOKEN dim_var_list
                  {
                    $$ = $2;
                  }
                ;

dim_var_list: var_ref
                {
                }
              | dim_var_list ',' var_ref 
                {
                }
              ;

/*********************************************************

 END

 *********************************************************/ 
              
END_statement:  END_TOKEN
                ;

/********************************************************* 

 FOR/NEXT/STEP

 *********************************************************/ 

FOR_statement: FOR_TOKEN var_ref '=' expression TO_TOKEN expression opt_STEP_statement
                {
                  $$ = nullptr;
                }
                ;

NEXT_statement: NEXT_TOKEN opt_varname
                ;

opt_varname:    /* empty */
                | var_ref
                ;                

opt_STEP_statement: /* empty */
                    | STEP_TOKEN expression
                    ;

/*********************************************************

 GOSUB/RETURN

 *********************************************************/ 
              
GOSUB_statement:  GOSUB_TOKEN line_number
                ;

RETURN_statement:  RETURN_TOKEN
                ;

/*********************************************************

 GOTO

 *********************************************************/ 
              
GOTO_statement: GOTO_TOKEN line_number
                  {
                  }
                ;

/*********************************************************

 IF/THEN/ELSE

 *********************************************************/ 

IF_statement: IF_TOKEN expression THEN_TOKEN conditional_clause opt_ELSE_statement
              ;

opt_ELSE_statement:   /* empty */
                      | ELSE_statement
                      ;              

ELSE_statement: ELSE_TOKEN conditional_clause
                ;

conditional_clause:   line_number
                      | statement_list 
                      ; 

/********************************************************* 

 INPUT  

 *********************************************************/ 

 INPUT_statement: INPUT_TOKEN QUOTED_STRING ';' input_var_list
                  | INPUT_TOKEN input_var_list
                  ;

 input_var_list:  input_var
                  | input_var_list ',' input_var
                  ;

 input_var:       var_ref
                  ;       

/********************************************************* 

 LET              

 *********************************************************/ 

LET_statement:  opt_LET_TOKEN assign_expression
                {
                  $$ = $2;
                }
                ;

opt_LET_TOKEN:  /* empty */
                | LET_TOKEN
                ;

assign_expression:  var_ref '=' expression
                      {
                        $$ = new AST::Assign($1, $3);
                      }
                    ;

/********************************************************* 

 ON
 
 *********************************************************/ 

ON_statement:    ON_TOKEN expression GOTO_TOKEN line_number opt_on_list
                  ;

opt_on_list:     /* empty */
                  | ',' line_number opt_on_list
                  ;                 

/********************************************************* 

 PRINT              
 
 *********************************************************/   

PRINT_statement:  print_keyword
                    {
                    }
                  opt_USING
                    {
                    }  
                  print_expression_list
                    {
                      $$ = new AST::Print($5);
                    }
                  ;

print_keyword:   PRINT_TOKEN
                 | '?'
                    { 
                    }
                 ;

opt_USING:      /* empty */
                | USING_TOKEN expression ';'
                ;                       

print_expression_list: /* empty */
                          {
                            $$ = nullptr;
                          }  
                       | print_expression_list print_expression
                          {
                            if ($1 == nullptr)
                              $1 = new AST::ExprList();
                            $1->Append($2);
                            $$ = $1;
                          }
                       ;

print_expression:      expression
                          {
                            $$ = $1;
                          }
                       | ',' 
                          {
                            $$ = new AST::PrintComma();
                          }
                       | ';'
                          {
                            $$ = new AST::PrintSemiColon();
                          }
                       ;                           

/********************************************************* 

 REM              
 
 *********************************************************/ 

REM_statement: rem_keyword
                  {
                    MBASIC_SetRemMode();
                  }
               ;

 rem_keyword: REM_TOKEN
              | '\''
                { 
                  Warning(eWarning_RemUsingQuote, "single quote REM not supported in selected language profile"); 
                }
              ;              

/********************************************************* 

 RUN
 
 *********************************************************/ 

RUN_statement: RUN_TOKEN QUOTED_STRING
              ;

/********************************************************* 

 STOP              
 
 *********************************************************/ 

STOP_statement: STOP_TOKEN
                ;

/********************************************************* 

 SYSTEM              
 
 *********************************************************/ 

SYSTEM_statement: SYSTEM_TOKEN
                ;

/********************************************************* 

 WIDTH              
 
 *********************************************************/ 

WIDTH_statement: WIDTH_TOKEN integer
                  {
                  }
               ;

/********************************************************* 

 expression              

 *********************************************************/ 

expression: AND_expression OR_TOKEN expression
              {
                $$ = nullptr;
              }
            | AND_expression
              {
                $$ = $1;
              }  
            ;

AND_expression: NOT_expression AND_TOKEN AND_expression
                  {
                    $$ = nullptr;
                  }
                | NOT_expression
                  {
                    $$ = $1;
                  }
                ;

NOT_expression: '-' compare_expression
                  {
                    $$ = nullptr;
                  }
                | compare_expression
                  {
                    $$ = $1;
                  }
                ;

compare_expression: ADD_expression '=' compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression NOT_EQUAL compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression '>' compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression GREATERTHANEQUAL compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression '<' compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression LESSTHANEQUAL compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression 
                      {
                        $$ = $1;
                      }
                    ;

ADD_expression: MULT_expression '+' ADD_expression
                  { 
                    $$ = nullptr;
                  }
                | MULT_expression '-' ADD_expression
                  { 
                    $$ = nullptr;
                  }
                | MULT_expression
                  {
                    $$ = $1;
                  }  
                ;

MULT_expression:  NEGATE_expression '*' MULT_expression
                    { 
                      $$ = nullptr;
                    }
                  | NEGATE_expression '/' MULT_expression
                    { 
                      $$ = nullptr;
                    }  
                  | NEGATE_expression
                    {
                      $$ = $1;  
                    } 
                  ;   
                          
NEGATE_expression:  '-' POWER_expression
                      {
                        $$ = nullptr;
                      }  
                    | POWER_expression
                      {
                        $$ = $1;
                      }
                    ;  

POWER_expression: POWER_expression '^' subexpression
                    {
                      $$ = nullptr;
                    }
                  | subexpression
                      {
                        $$ = $1;
                      }
                  ;

subexpression: '(' expression ')'
                  {
                    $$ = $2;
                  }
                | value
                  {
                    $$ = $1;
                  }
                ;                           

value:          var_ref
                  {
                    $$ = $1;
                  }
                | CHR_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | INT_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | LEFT_TOKEN '(' expression ',' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | MID_TOKEN '(' expression ',' expression ',' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | RIGHT_TOKEN '(' expression ',' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | STR_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | SQR_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | TAB_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | const_expr
                  {
                    $$ = $1;
                  }
                ;  

/********************************************************* 

var or array ref              
 
 *********************************************************/

var_ref : var_name
            {
              $$ = $1;
            }
          | var_name array_or_func_spec
            {
            }
          ;

var_name: IDENTIFIER
            {
              $$ = new AST::VarRef(AST::VarType::eDefault, *$1);
            }
          | INTEGER_VARNAME
            {
              $$ = new AST::VarRef(AST::VarType::eInteger, *$1);
            }
          | STRING_VARNAME
            {
              $$ = new AST::VarRef(AST::VarType::eString, *$1);
            }
          | SINGLE_VARNAME
            {
              $$ = new AST::VarRef(AST::VarType::eSingle, *$1);
            }
          | DOUBLE_VARNAME
            {
              $$ = new AST::VarRef(AST::VarType::eDouble, *$1);
            }
          ;

array_or_func_spec: '(' array_or_func_args ')'
                      {
                      }
                    ; 

array_or_func_args: array_or_func_arg 
                      {
                      }
                    | array_or_func_args ',' array_or_func_arg   
                      {
                      }
                    ;

array_or_func_arg:  expression
                      {
                      }
                    ;

/********************************************************* 

 miscellaneous              
 
 *********************************************************/ 

const_expr: INTEGER
              {
                $$ = new AST::IntegerValue($1);
              }
            | DOUBLE
              {
                $$ = new AST::DoubleValue($1->m_value);
                delete $1;
              }
            | SINGLE
              {
                $$ = new AST::SingleValue($1->m_value);
                delete $1;
              }
            | DEF_INTEGER  
              {
                $$ = new AST::DefaultValue(*$1);
                delete $1;
              }
            | QUOTED_STRING
              {
                $$ = new AST::StringValue(*$1);
                delete $1;
              }
            ;
