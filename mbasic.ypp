%name-prefix "MBASIC_" 
%define parse.error verbose

%{

#include <iostream>
#include <string>
#include <sstream>
#include <memory>
using namespace std;

#include "basalt.h"

#define YYDEBUG 1

namespace std {
template<typename T, typename... Args>
std::unique_ptr<T> make_unique(Args&&... args) {
    return std::unique_ptr<T>(new T(std::forward<Args>(args)...));
}
}


static AST::ExprList * ConcatExprLists(AST::ExprList * a, AST::ExprList * b)
{
  if (b == nullptr)
    return a;

  for (auto & r : *b) {
    if (r != nullptr)
      a->push_back(r);
  }

  return a;
}


extern void MBASIC_SetRemMode();

%}

%union {
  char          cval;
  unsigned int  uval;
  int           ival;
  std::string * sval;

  SingleFloat * sfloat;
  DoubleFloat * dfloat;

  AST::Expr     * expr;
  AST::ExprList * exprlist;
}

%token EOL_TOKEN
%token EOF_TOKEN
%token LET_TOKEN
%token PRINT_TOKEN
%token REM_TOKEN

%token <sval>   IDENTIFIER INTEGER_VARNAME STRING_VARNAME
%token <sval>   QUOTED_STRING
%token <uval>   POSITIVE_INT
%token <ival>   NEGATIVE_INT
%token <dfloat> DOUBLE
%token <sfloat> SINGLE

%type <ival>     integer

%type <exprlist>    MBASIC_file line opt_statement_list statement_list statement

%type <expr>        PRINT_statement print_expression
%type <exprlist>    print_expression_list 

%type <exprlist>    LET_statement assign_expression 
%type <expr>        numeric_expression numeric_expr2 numeric_expr3 number 
%type <expr>        string_expression 
%type <expr>        const_integer_expr

%type <sval>        string_constant

%%

MBASIC_file:  line
                {
                  ConcatExprLists(&g_expressions, $1);
                  delete $1;
                }
              | MBASIC_file line
                {
                  ConcatExprLists(&g_expressions, $2);
                  delete $2;
                } 
              ;

/*********************************************************F

 line              

 *********************************************************/ 

line:     opt_line_number opt_statement_list eol
            {
              $$ = $2;
            }
          ;

opt_line_number: /* empty */
                 | POSITIVE_INT
                 ; 

opt_statement_list : /* empty */
                      {
                        $$ = nullptr;
                      }
                   | statement_list
                      {
                        $$ = $1;
                      }
                   ;

statement_list : statement
                  {
                    $$ = $1;
                  }   
               | statement_list ':' statement
                  {
                    ConcatExprLists($1, $3);
                    delete $3;  
                  }   
               ;

statement:     LET_statement
                  {
                    $$ = $1;
                  }
               | PRINT_statement 
                  {
                    $$ = new AST::ExprList();
                    $$->push_back($1);
                  }
               | REM_statement
                  {
                    $$ = nullptr;
                  }
               | error /* bison error handler */   
                  {
                    $$ = nullptr;
                  }
               ;

eol:    EOL_TOKEN
        | EOF_TOKEN
          { return 0; }
        ;               

/********************************************************* 

 LET              

 *********************************************************/ 

LET_statement:  opt_LET_TOKEN assign_expression
                {
                  $$ = $2;
                }
                ;

opt_LET_TOKEN:  /* empty */
                | LET_TOKEN
                ;

assign_expression:  IDENTIFIER '=' numeric_expression
                        {
                          std::string name(*$1 + "%");
                          $$ = new AST::ExprList();
                          $$->push_back(
                                    new AST::Int16VariableDefExpr(name, false)
                                      );
                          $$->push_back(
                                    new AST::BinaryExpr('=', 
                                                   new AST::VariableRefExpr(name), 
                                                   $3
                                                   )
                                       );
                          delete $1;
                        }
                    | INTEGER_VARNAME '=' numeric_expression
                        {                        
                          $$ = new AST::ExprList();
                          std::string name(*$1 + "%");
                          //AST::Expr * expr = new AST::IntVariableDefExpr(*$1 + "%", false);                          
                          //$$ = new AST::BinaryExpr('=', expr, $3);
                          //delete $1;
                        }
                    | STRING_VARNAME '=' string_expression
                        {
                          $$ = new AST::ExprList();
                          /*
                          CodeGenerator::Variable * var = g_variables.Add<CodeGenerator::StringVariable>(*$1, true);
                          if (var == NULL) {
                            cerr << "Variable '" << *$1 << " redefined type" << endl;
                                AST::Expr * expr = new IntVariableExpr()
                          $$ = new AST::BinaryExpr('=', $1, $2);
                          $$ = nullptr;
                          }
                          else 
                            $$ = new CodeGenerator::StringAssignExpr(var, $3);
                          delete $1;
                          */
                        }
                    | numeric_expression
                        {
                          $$ = new AST::ExprList();
                          $$->push_back($1);
                        }    
                    ;

/********************************************************* 

 PRINT              
 
 *********************************************************/ 

PRINT_statement:  print_keyword print_expression_list
                    {
                      $$ = new AST::BIFExpr("print", $2);
                    }
                  ;

print_keyword:   PRINT_TOKEN
                 | '?'
                    { 
                      cout << "warning: question mark PRINT not supported in basic-8k" << endl; 
                    }
                 ;                 

print_expression_list: /* empty */
                          {
                            $$ = new AST::ExprList;
                          }  
                       | print_expression_list print_expression
                          {
                            $1->push_back($2);
                          }
                       ;

print_expression:      string_expression
                          {
                            $$ = $1;
                          }
                       | ',' 
                          {
                            $$ = nullptr; //new PrintElement();
                          }
                       | ';'
                          {
                            $$ = nullptr; //new PrintElement();
                          }
                       | numeric_expression
                          {
                            $$ = $1;
                          }
                       ;                           

/********************************************************* 

 REM              
 
 *********************************************************/ 

REM_statement: rem_keyword
                  {
                    MBASIC_SetRemMode();
                  }
               ;

 rem_keyword: REM_TOKEN
              | '\''
                { cout << "warning: single quote REM not supported in basic-8k" << endl; }
              ;              



/********************************************************* 

 numeric expression              

 *********************************************************/ 

numeric_expression: numeric_expression '-' numeric_expr2 
                      { 
                        $$ = new AST::BinaryExpr('-', $1, $3);
                      }
                    | numeric_expression '+' numeric_expr2 
                      { 
                        $$ = new AST::BinaryExpr('+', $1, $3);
                      }
                    | numeric_expr2
                      {
                        $$ = $1;
                      }
                    ;


numeric_expr2:      numeric_expr2 '*' numeric_expr3 
                      { 
                        $$ = new AST::BinaryExpr('*', $1, $3);
                      }
                    | numeric_expr2 '/' numeric_expr3 
                      { 
                        $$ = new AST::BinaryExpr('/', $1, $3);
                      }
                    | numeric_expr3
                      {
                        $$ = $1;
                      }  
                    ;

numeric_expr3:      '(' numeric_expression ')'
                      {
                        $$ = $2;
                      }                    
                    | '-' numeric_expr3
                      {
                        $$ = $2;
                      }
                    | number
                      {
                        $$ = $1;
                      }  
                    ;
                      
number:             const_integer_expr
                      {
                        $$ = $1;
                      }
                    | SINGLE
                      { 
                        $$ = nullptr;
                        //$$ = new CodeGenerator::ConstantInt16Expr($1->m_value);
                        //delete $1; 
                      }
                    | DOUBLE
                      { 
                        $$ = nullptr;
                        //$$ = NULL; 
                      }
                    | IDENTIFIER
                      { 
                        $$ = new AST::VariableRefExpr(*$1 + "%");
                      } 
                    ;  

/********************************************************* 

 string expression              
 
 *********************************************************/ 

string_expression:  string_constant
                      {
                        $$ = new AST::ConstantStringExpr(*$1, false);
                        delete $1;
                      }
                    ;

/********************************************************* 

 miscellaneous              
 
 *********************************************************/ 

const_integer_expr: integer
                      {
                        $$ = new AST::ConstantInt16Expr($1);
                      }
                    ;

integer:        POSITIVE_INT
                  {
                    $$ = $1;
                  }
                | NEGATIVE_INT
                  {
                    $$ = $1;
                  }
                ;

string_constant:    QUOTED_STRING
                    {
                      $$ = $1;
                      //auto r = m_globalStringConstants.find(*$1);
                      //if (r != m_globalStringConstants.end())
                      //  $$ = r->second;
                      //else {
                      //  auto * expr = new CodeGenerator::ConstantStringExpr(*$1, true);
                      //  m_globalStringConstants[*$1] = expr;
                      //  $$ = expr;
                      //}  
                      //delete $1;  
                    }                    
                    ;