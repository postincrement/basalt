%name-prefix "MBASIC_" 
%define parse.error verbose

%{

#include <iostream>
#include <string>
#include <sstream>
#include <memory>
using namespace std;

#include "basalt.h"

#define YYDEBUG 1

static bool g_needsNewLine = false;

namespace std {
template<typename T, typename... Args>
std::unique_ptr<T> make_unique(Args&&... args) {
    return std::unique_ptr<T>(new T(std::forward<Args>(args)...));
}
}


static AST::ExprList * ConcatExprLists(AST::ExprList * a, AST::ExprList * b)
{
  if (b == nullptr)
    return a;

  for (auto & r : *b) {
    if (r != nullptr)
      a->push_back(r);
  }

  return a;
}

template<class DefExprType, class RefExprType, class BinExprType>
static AST::ExprList * DefineVariable(AST::VariableDef::Type type,
                                      const std::string & name_, 
                                             const char * suffix,
                                              AST::Expr * expr)
{
  if (name_.length() > g_profile.m_identifierLen+1) {
    stringstream strm;
    strm << "identifier longer than maximum of " << g_profile.m_identifierLen;
    g_application.OnWarning(strm.str());
  }

  std::string name   (name_.substr(0, g_profile.m_identifierLen) + suffix);
  std::string defName(name_ + suffix);

  auto r = g_variables.find(name);
  if (r == g_variables.end()) {
    g_variables[name] = AST::VariableDef(type, name, defName);
  }
  else if (r->second.m_defName != defName) {
    stringstream strm;
    strm << "identifier first defined as " << r->second.m_defName << " now defined as " << defName;
    g_application.OnWarning(strm.str());
  }

  AST::ExprList * exprList = new AST::ExprList();

  exprList->push_back(
            new DefExprType(name, false)
              );

  exprList->push_back(
            new BinExprType('=', new RefExprType(name), expr)
               );

  return exprList;             
}

extern void MBASIC_SetRemMode();

%}

%union {
  char          cval;
  unsigned int  uval;
  int           ival;
  std::string * sval;

  SingleFloat * sfloat;
  DoubleFloat * dfloat;

  AST::Expr     * expr;
  AST::ExprList * exprlist;
}

%token EOL_TOKEN
%token EOF_TOKEN

%token CLEAR_TOKEN
%token FOR_TOKEN
%token LET_TOKEN
%token NEXT_TOKEN
%token PRINT_TOKEN
%token REM_TOKEN
%token STEP_TOKEN
%token TO_TOKEN
%token WIDTH_TOKEN

%token <sval>   IDENTIFIER INTEGER_VARNAME STRING_VARNAME SINGLE_VARNAME DOUBLE_VARNAME
%token <sval>   QUOTED_STRING
%token <uval>   POSITIVE_INT
%token <ival>   NEGATIVE_INT
%token <dfloat> DOUBLE
%token <sfloat> SINGLE

%type <ival>     integer 
%type <sval>     opt_line_number

%type <exprlist>    MBASIC_file line opt_statement_list statement_list statement

%type <expr>        print_expression
%type <exprlist>    PRINT_statement print_expression_list 

%type <exprlist>    LET_statement assign_expression 
%type <expr>        integer_expression number /* int_mult_expression int_paren_expression */  
%type <expr>        string_expression 

%type <expr>        WIDTH_statement

%type <expr>        const_integer_expr
%type <sval>        string_constant

//%token NUM
%left '-' '+'
%left '*' '/'
%left NEG     /* negation--unary minus */
//%right '^'    /* exponentiation        */

%%

MBASIC_file:  line
                {
                  ConcatExprLists(&g_expressions, $1);
                  delete $1;
                }
              | MBASIC_file line
                {
                  ConcatExprLists(&g_expressions, $2);
                  delete $2;
                } 
              ;

/*********************************************************F

 line              

 *********************************************************/ 

line:     opt_line_number
            {
              AST::LineMarkerExpr * marker; 
              if ($1 == nullptr)
                marker = new AST::LineMarkerExpr();
              else {
                marker = new AST::LineMarkerExpr(*$1);
                delete $1;
              }
              marker->m_line = g_application.m_line;
              $<expr>$ = marker;
            }
          opt_statement_list eol
            {
              $$ = new AST::ExprList();
              $$->push_back($<expr>2);
              ConcatExprLists($$, $3);
            }
          ;

opt_line_number: /* empty */
                    { $$ = nullptr; }
                 | POSITIVE_INT
                    {
                      // extract line number literal string
                      std::string & line = g_application.m_line;
                      size_t i;
                      for (i = 0; i < line.length() && !isspace(line[i]); ++i)
                        ;
                      $$ = new std::string(line.substr(0, i));
                    }
                 ; 

opt_statement_list : /* empty */
                      {
                        $$ = nullptr;
                      }
                   | statement_list
                      {
                        $$ = $1;
                      }
                   ;

statement_list : statement
                  {
                    $$ = $1;
                  }   
               | statement_list ':' statement
                  {
                    if ($1 == nullptr)
                      $$ = $1;
                    else {  
                      ConcatExprLists($1, $3);
                      delete $3;
                    }
                  }   
               ;

statement:     CLEAR_statement
                  {
                    $$ = nullptr;
                  }
               | FOR_statement
                  {
                    $$ = nullptr;
                  }
               | LET_statement
                  {
                    $$ = $1;
                  }
               | NEXT_statement
                  {
                    $$ = nullptr;
                  }
               | PRINT_statement 
                  {
                    $$ = $1;
                  }
               | REM_statement
                  {
                    $$ = nullptr;
                  }
               | WIDTH_statement
                  {
                    $$ = new AST::ExprList($1);
                  }
               | error /* bison error handler */   
                  {
                    $$ = nullptr;
                  }
               ;

eol:    EOL_TOKEN
        | EOF_TOKEN
          { return 0; }
        ;               

/********************************************************* 

  CLEAR

 *********************************************************/ 

CLEAR_statement: CLEAR_TOKEN integer_expression
                 ;

/********************************************************* 

 FOR/NEXT/STEP

 *********************************************************/ 

FOR_statement: FOR_TOKEN INTEGER_VARNAME '=' integer_expression TO_TOKEN integer_expression opt_STEP_statement
                ;

NEXT_statement: NEXT_TOKEN opt_varname
                ;

opt_varname:    /* empty */
                | INTEGER_VARNAME
                ;                

opt_STEP_statement: /* empty */
                    | STEP_TOKEN integer_expression
                    ;

/********************************************************* 

 LET              

 *********************************************************/ 

LET_statement:  opt_LET_TOKEN assign_expression
                {
                  $$ = $2;
                }
                ;

opt_LET_TOKEN:  /* empty */
                | LET_TOKEN
                ;

assign_expression:  IDENTIFIER '=' integer_expression
                        {
                          $$ = DefineVariable<AST::Int16VariableDefExpr,
                                              AST::Int16VariableRefExpr,
                                              AST::Int16BinaryExpr>(
                                                  AST::VariableDef::eInt16,
                                                  *$1, "%", $3
                                              );
                          delete $1;
                        }
                    | INTEGER_VARNAME '=' integer_expression
                        {
                          $$ = DefineVariable<AST::Int16VariableDefExpr,
                                              AST::Int16VariableRefExpr,
                                              AST::Int16BinaryExpr>(
                                                  AST::VariableDef::eInt16,
                                                  *$1, "", $3
                                              );
                          delete $1;
                        }
                    | STRING_VARNAME '=' string_expression
                        {
                          $$ = DefineVariable<AST::StringVariableDefExpr,
                                              AST::StringVariableRefExpr,
                                              AST::StringBinaryExpr>(
                                                  AST::VariableDef::eString,
                                                  *$1, "", $3
                                              );
                          delete $1;
                        }
                    ;

/********************************************************* 

 PRINT              
 
 *********************************************************/ 

PRINT_statement:  print_keyword
                    {
                      g_needsNewLine = true;
                    }
                  print_expression_list
                    {
                      if (g_needsNewLine) {
                        if ($3 == nullptr)
                          $$ = new AST::ExprList();
                        else
                          $$ = $3;
                        $3->push_back(new AST::BIFExpr("print_newline", nullptr));
                      }
                      $$ = $3;
                    }
                  ;

print_keyword:   PRINT_TOKEN
                 | '?'
                    { 
                      cout << "warning: question mark PRINT not supported in basic-8k" << endl; 
                    }
                 ;                 

print_expression_list: /* empty */
                          {
                            $$ = new AST::ExprList;
                            g_needsNewLine = true;
                          }  
                       | print_expression_list print_expression
                          {
                            if ($2 != nullptr)
                              $1->push_back($2);
                            $$ = $1;
                          }
                       ;

print_expression:      string_expression
                          {
                            g_needsNewLine = true;
                            AST::ExprList * args = new AST::ExprList($1);
                            $$ = new AST::BIFExpr("print_string", args);
                          }
                       | integer_expression
                          {
                            g_needsNewLine = true;
                            AST::ExprList * args = new AST::ExprList($1);
                            $$ = new AST::BIFExpr("print_integer", args);
                          }
                       | ',' 
                          {
                            g_needsNewLine = false;
                            $$ = new AST::BIFExpr("print_comma", nullptr);
                          }
                       | ';'
                          {
                            g_needsNewLine = false;
                            $$ = nullptr;
                          }
                       ;                           

/********************************************************* 

 REM              
 
 *********************************************************/ 

REM_statement: rem_keyword
                  {
                    MBASIC_SetRemMode();
                  }
               ;

 rem_keyword: REM_TOKEN
              | '\''
                { cout << "warning: single quote REM not supported in basic-8k" << endl; }
              ;              


/********************************************************* 

 WIDTH              
 
 *********************************************************/ 

WIDTH_statement: WIDTH_TOKEN POSITIVE_INT
                  {
                  }
               ;


/********************************************************* 

 integer expression              

 *********************************************************/ 

integer_expression: number
                        {
                          $$ = $1;
                        }

                    | integer_expression '+' integer_expression 
                      { 
                        $$ = new AST::Int16BinaryExpr('+', $1, $3);
                      }

                    | integer_expression '-' integer_expression 
                      { 
                        $$ = new AST::Int16BinaryExpr('-', $1, $3);
                      }

                    | integer_expression '*' integer_expression 
                      { 
                        $$ = new AST::Int16BinaryExpr('*', $1, $3);
                      }

                    | integer_expression '/' integer_expression 
                      { 
                        $$ = new AST::Int16BinaryExpr('/', $1, $3);
                      }
                    | '-' integer_expression %prec NEG
                      {
                        $$ = $2;
                      }
                    | '(' integer_expression ')'
                        {
                          $$ = $2;
                        } 
                    ;                      
                      
number:             const_integer_expr
                      {
                        $$ = $1;
                      }

                    | IDENTIFIER
                      {
                        $$ = new AST::Int16VariableRefExpr(*$1 + "%");
                        delete $1;
                      }

                    | INTEGER_VARNAME
                      { 
                        $$ = new AST::Int16VariableRefExpr(*$1);
                      } 

                    | SINGLE
                      { 
                        $$ = nullptr;
                      }

                    | DOUBLE
                      { 
                        $$ = nullptr;
                      }
                    ;  

/********************************************************* 

 string expression              
 
 *********************************************************/ 

string_expression:  string_constant
                      {
                        $$ = new AST::StringConstantExpr(*$1, false);
                        delete $1;
                      }

                    | STRING_VARNAME
                      {
                        $$ = new AST::StringVariableRefExpr(*$1);
                        delete $1;
                      }
                    ;

/********************************************************* 

 miscellaneous              
 
 *********************************************************/ 

const_integer_expr: integer
                      {
                        $$ = new AST::Int16ConstantExpr($1);
                      }
                    ;

integer:        POSITIVE_INT
                  {
                    $$ = $1;
                  }
                | NEGATIVE_INT
                  {
                    $$ = $1;
                  }
                ;

string_constant:    QUOTED_STRING
                    {
                      $$ = $1;
                      //auto r = m_globalStringConstants.find(*$1);
                      //if (r != m_globalStringConstants.end())
                      //  $$ = r->second;
                      //else {
                      //  auto * expr = new CodeGenerator::ConstantStringExpr(*$1, true);
                      //  m_globalStringConstants[*$1] = expr;
                      //  $$ = expr;
                      //}  
                      //delete $1;  
                    }                    
                    ;