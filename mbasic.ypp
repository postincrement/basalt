extern void MBASIC_SetRemMode();

%}

%union {
  char          cval;
  unsigned int  uval;
  int           ival;
  std::string * sval;

  SingleFloat * sfloat;
  DoubleFloat * dfloat;

  AST::Expr     * expr;
  AST::ExprList * exprlist;
}

%token EOL_TOKEN
%token EOF_TOKEN
%token LET_TOKEN
%token PRINT_TOKEN
%token REM_TOKEN

%token <sval>   IDENTIFIER INTEGER_VARNAME STRING_VARNAME SINGLE_VARNAME DOUBLE_VARNAME
%token <sval>   QUOTED_STRING
%token <uval>   POSITIVE_INT
%token <ival>   NEGATIVE_INT
%token <dfloat> DOUBLE
%token <sfloat> SINGLE

%type <ival>     integer opt_line_number

%type <exprlist>    MBASIC_file line opt_statement_list statement_list statement

%type <expr>        PRINT_statement print_expression
%type <exprlist>    print_expression_list 

%type <exprlist>    LET_statement assign_expression 
%type <expr>        integer_expression number /* int_mult_expression int_paren_expression */  
%type <expr>        string_expression 

%type <expr>        const_integer_expr
%type <sval>        string_constant

//%token NUM
%left '-' '+'
%left '*' '/'
%left NEG     /* negation--unary minus */
//%right '^'    /* exponentiation        */

%%

MBASIC_file:  line
                {
                  if ($1->m_lineNumber >= 0) {
                    // insert line number here
                  }
                  ConcatExprLists(&g_expressions, $1);
                  delete $1;
                }
              | MBASIC_file line
                {
                  if ($2->m_lineNumber >= 0) {
                    // insert line number here
                  }
                  ConcatExprLists(&g_expressions, $2);
                  delete $2;
                } 
              ;

/*********************************************************F

 line              

 *********************************************************/ 

line:     opt_line_number opt_statement_list eol
            {
              $$ = $2;
              if ($1 >= 0) {
                if ($$ == nullptr)
                  ; //cout << "line " << $1 << " has no statements" << endl;
                else  
                  $$->m_lineNumber = $1;
              }
            }
          ;

opt_line_number: /* empty */
                    { $$ = -1; }
                 | POSITIVE_INT
                    { $$ = $1; }
                 ; 

opt_statement_list : /* empty */
                      {
                        $$ = nullptr;
                      }
                   | statement_list
                      {
                        $$ = $1;
                      }
                   ;

statement_list : statement
                  {
                    $$ = $1;
                  }   
               | statement_list ':' statement
                  {
                    ConcatExprLists($1, $3);
                    delete $3;  
                  }   
               ;

statement:     LET_statement
                  {
                    $$ = $1;
                  }
               | PRINT_statement 
                  {
                    $$ = new AST::ExprList();
                    $$->push_back($1);
                  }
               | REM_statement
                  {
                    $$ = nullptr;
                  }
               | error /* bison error handler */   
                  {
                    $$ = nullptr;
                  }
               ;

eol:    EOL_TOKEN
        | EOF_TOKEN
          { return 0; }
        ;               

/********************************************************* 

 LET              

 *********************************************************/ 

LET_statement:  opt_LET_TOKEN assign_expression
                {
                  $$ = $2;
                }
                ;

opt_LET_TOKEN:  /* empty */
                | LET_TOKEN
                ;

assign_expression:  IDENTIFIER '=' integer_expression
                        {
                          $$ = DefineVariable<AST::Int16VariableDefExpr,
                                              AST::Int16VariableRefExpr,
                                              AST::Int16BinaryExpr>(
                                                  AST::VariableDef::eInt16,
                                                  *$1, "%", $3
                                              );
                          delete $1;
                        }
                    | INTEGER_VARNAME '=' integer_expression
                        {
                          $$ = DefineVariable<AST::Int16VariableDefExpr,
                                              AST::Int16VariableRefExpr,
                                              AST::Int16BinaryExpr>(
                                                  AST::VariableDef::eInt16,
                                                  *$1, "", $3
                                              );
                          delete $1;
                        }
                    | STRING_VARNAME '=' string_expression
                        {
                          $$ = DefineVariable<AST::StringVariableDefExpr,
                                              AST::StringVariableRefExpr,
                                              AST::StringBinaryExpr>(
                                                  AST::VariableDef::eString,
                                                  *$1, "", $3
                                              );
                          delete $1;
                        }
                    ;

/********************************************************* 

 PRINT              
 
 *********************************************************/ 

PRINT_statement:  print_keyword print_expression_list
                    {
                      $$ = new AST::BIFExpr("print", $2);
                    }
                  ;

print_keyword:   PRINT_TOKEN
                 | '?'
                    { 
                      cout << "warning: question mark PRINT not supported in basic-8k" << endl; 
                    }
                 ;                 

print_expression_list: /* empty */
                          {
                            $$ = new AST::ExprList;
                          }  
                       | print_expression_list print_expression
                          {
                            $1->push_back($2);
                          }
                       ;

print_expression:      string_expression
                          {
                            $$ = $1;
                          }
                       | integer_expression
                          {
                            $$ = $1;
                          }
                       | ',' 
                          {
                            $$ = new AST::PrintCommaExpr();
                          }
                       | ';'
                          {
                            $$ = new AST::PrintSemiColonExpr();
                          }
                       ;                           

/********************************************************* 

 REM              
 
 *********************************************************/ 

REM_statement: rem_keyword
                  {
                    MBASIC_SetRemMode();
                  }
               ;

 rem_keyword: REM_TOKEN
              | '\''
                { cout << "warning: single quote REM not supported in basic-8k" << endl; }
              ;              



/********************************************************* 

 integer expression              

 *********************************************************/ 

integer_expression: number
                        {
                          $$ = $1;
                        }

                    | integer_expression '+' integer_expression 
                      { 
                        $$ = new AST::Int16BinaryExpr('+', $1, $3);
                      }

                    | integer_expression '-' integer_expression 
                      { 
                        $$ = new AST::Int16BinaryExpr('-', $1, $3);
                      }

                    | integer_expression '*' integer_expression 
                      { 
                        $$ = new AST::Int16BinaryExpr('*', $1, $3);
                      }

                    | integer_expression '/' integer_expression 
                      { 
                        $$ = new AST::Int16BinaryExpr('/', $1, $3);
                      }
                    | '-' integer_expression %prec NEG
                      {
                        $$ = $2;
                      }
                    | '(' integer_expression ')'
                        {
                          $$ = $2;
                        } 
                    ;                      
                      
number:             const_integer_expr
                      {
                        $$ = $1;
                      }

                    | IDENTIFIER
                      {
                        $$ = new AST::Int16VariableRefExpr(*$1 + "%");
                        delete $1;
                      }

                    | INTEGER_VARNAME
                      { 
                        $$ = new AST::Int16VariableRefExpr(*$1);
                      } 

                    | SINGLE
                      { 
                        $$ = nullptr;
                      }

                    | DOUBLE
                      { 
                        $$ = nullptr;
                      }
                    ;  

/********************************************************* 

 string expression              
 
 *********************************************************/ 

string_expression:  string_constant
                      {
                        $$ = new AST::StringConstantExpr(*$1, false);
                        delete $1;
                      }

                    | STRING_VARNAME
                      {
                        $$ = new AST::StringVariableRefExpr(*$1);
                        delete $1;
                      }
                    ;

/********************************************************* 

 miscellaneous              
 
 *********************************************************/ 

const_integer_expr: integer
                      {
                        $$ = new AST::Int16ConstantExpr($1);
                      }
                    ;

integer:        POSITIVE_INT
                  {
                    $$ = $1;
                  }
                | NEGATIVE_INT
                  {
                    $$ = $1;
                  }
                ;

string_constant:    QUOTED_STRING
                    {
                      $$ = $1;
                      //auto r = m_globalStringConstants.find(*$1);
                      //if (r != m_globalStringConstants.end())
                      //  $$ = r->second;
                      //else {
                      //  auto * expr = new CodeGenerator::ConstantStringExpr(*$1, true);
                      //  m_globalStringConstants[*$1] = expr;
                      //  $$ = expr;
                      //}  
                      //delete $1;  
                    }                    
                    ;