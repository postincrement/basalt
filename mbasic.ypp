%define api.prefix {MBASIC_}
%define api.token.prefix {MBASIC_TOK_}
%define parse.error verbose

%code provides {
/* Lexer uses the historical token spellings. Bison 3 prefixes them. */
#define EOL_TOKEN MBASIC_TOK_EOL_TOKEN
#define EOF_TOKEN MBASIC_TOK_EOF_TOKEN
#define GREATERTHANEQUAL MBASIC_TOK_GREATERTHANEQUAL
#define LESSTHANEQUAL MBASIC_TOK_LESSTHANEQUAL
#define NOT_EQUAL MBASIC_TOK_NOT_EQUAL
#define AND_TOKEN MBASIC_TOK_AND_TOKEN
#define CHR_TOKEN MBASIC_TOK_CHR_TOKEN
#define INT_TOKEN MBASIC_TOK_INT_TOKEN
#define LEFT_TOKEN MBASIC_TOK_LEFT_TOKEN
#define LEN_TOKEN MBASIC_TOK_LEN_TOKEN
#define MID_TOKEN MBASIC_TOK_MID_TOKEN
#define RIGHT_TOKEN MBASIC_TOK_RIGHT_TOKEN
#define SQR_TOKEN MBASIC_TOK_SQR_TOKEN
#define STR_TOKEN MBASIC_TOK_STR_TOKEN
#define TAB_TOKEN MBASIC_TOK_TAB_TOKEN
#define RND_TOKEN MBASIC_TOK_RND_TOKEN
#define ABS_TOKEN MBASIC_TOK_ABS_TOKEN
#define CLEAR_TOKEN MBASIC_TOK_CLEAR_TOKEN
#define DEF_TOKEN MBASIC_TOK_DEF_TOKEN
#define DIM_TOKEN MBASIC_TOK_DIM_TOKEN
#define ELSE_TOKEN MBASIC_TOK_ELSE_TOKEN
#define END_TOKEN MBASIC_TOK_END_TOKEN
#define FOR_TOKEN MBASIC_TOK_FOR_TOKEN
#define IF_TOKEN MBASIC_TOK_IF_TOKEN
#define GOSUB_TOKEN MBASIC_TOK_GOSUB_TOKEN
#define GOTO_TOKEN MBASIC_TOK_GOTO_TOKEN
#define INPUT_TOKEN MBASIC_TOK_INPUT_TOKEN
#define LINE_TOKEN MBASIC_TOK_LINE_TOKEN
#define LET_TOKEN MBASIC_TOK_LET_TOKEN
#define NEXT_TOKEN MBASIC_TOK_NEXT_TOKEN
#define OR_TOKEN MBASIC_TOK_OR_TOKEN
#define ON_TOKEN MBASIC_TOK_ON_TOKEN
#define PRINT_TOKEN MBASIC_TOK_PRINT_TOKEN
#define REM_TOKEN MBASIC_TOK_REM_TOKEN
#define RETURN_TOKEN MBASIC_TOK_RETURN_TOKEN
#define RUN_TOKEN MBASIC_TOK_RUN_TOKEN
#define STEP_TOKEN MBASIC_TOK_STEP_TOKEN
#define SYSTEM_TOKEN MBASIC_TOK_SYSTEM_TOKEN
#define STOP_TOKEN MBASIC_TOK_STOP_TOKEN
#define THEN_TOKEN MBASIC_TOK_THEN_TOKEN
#define TO_TOKEN MBASIC_TOK_TO_TOKEN
#define USING_TOKEN MBASIC_TOK_USING_TOKEN
#define WIDTH_TOKEN MBASIC_TOK_WIDTH_TOKEN
#define IDENTIFIER MBASIC_TOK_IDENTIFIER
#define QUOTED_STRING MBASIC_TOK_QUOTED_STRING
#define DEF_INTEGER MBASIC_TOK_DEF_INTEGER
#define INTEGER_VARNAME MBASIC_TOK_INTEGER_VARNAME
#define STRING_VARNAME MBASIC_TOK_STRING_VARNAME
#define SINGLE_VARNAME MBASIC_TOK_SINGLE_VARNAME
#define DOUBLE_VARNAME MBASIC_TOK_DOUBLE_VARNAME
#define COMMENT MBASIC_TOK_COMMENT
#define INTEGER MBASIC_TOK_INTEGER
#define DOUBLE MBASIC_TOK_DOUBLE
#define SINGLE MBASIC_TOK_SINGLE
}

%{

#include <iostream>
#include <string>
#include <sstream>
#include <memory>
using namespace std;

#include "common.h"
#include "basalt.h"

#define YYDEBUG 1

unsigned g_lexLineNumber     = 1;  // corrected source line number
std::string g_basicLineNumber;     // BASIC line number

static unsigned g_lineNumber = 1;     // parsed source line number

extern void MBASIC_SetRemMode();

#define ParserError(code, expr) \
do { std::stringstream strm; strm << expr; \
  g_application.ParserErrorInternal(ErrorCode::code, strm.str()); \
} while (0)

// used by parser to display error
void MBASIC_error(const char * msg)
{
  ParserError(eError_Parser, msg);
}

static AST::NumericExpr * CreateConstant(VarType type, const std::string & val)
{
  switch (type) {
    case VarType::eInt16:
      return AST::Int16Constant::Create(val);
    case VarType::eInt32:
      return AST::Int32Constant::Create(val);
    case VarType::eSingle:
      return AST::SingleConstant::Create(val);
    case VarType::eDouble:
      return AST::DoubleConstant::Create(val);
    case VarType::eString:
      break;
  }
  return nullptr;
}

static void UseNumericGlobalVar(AST::NumericVarRef & var, bool left, bool right)
{
  if (AST::g_globalVars.count(var.GetName()) == 0) {
    AST::VarInfo info;
    info.m_type         = var.GetType();
    info.m_originalName = var.GetOriginalName(); 
    if (left)
      info.m_lhsLine = g_lineNumber;
    if (right)   
      info.m_rhsLine  = g_lineNumber;
    AST::g_globalVars[var.GetName()] = info;
  }
  else {
    AST::VarInfo & info = AST::g_globalVars[var.GetName()];
    if (var.GetOriginalName() != info.m_originalName) {
      ParserError(eWarning_VarIsSynonym,
                  "'" << var.GetOriginalName() << "' & '" << info.m_originalName << "'");
    }
    if (left && (info.m_lhsLine == 0))
      info.m_lhsLine = g_lineNumber;
    if (right && (info.m_rhsLine == 0))
      info.m_rhsLine = g_lineNumber;
  }
}

static void UseStringGlobalVar(AST::StringVarRef & var, bool left, bool right)
{
  if (AST::g_globalVars.count(var.GetName()) == 0) {
    AST::VarInfo info;
    info.m_type         = var.GetType();
    info.m_originalName = var.GetOriginalName(); 
    if (left)
      info.m_lhsLine = g_lineNumber;
    if (right)   
      info.m_rhsLine  = g_lineNumber;
    AST::g_globalVars[var.GetName()] = info;
  }
  else {
    AST::VarInfo & info = AST::g_globalVars[var.GetName()];
    if (var.GetOriginalName() != info.m_originalName) {
      ParserError(eWarning_VarIsSynonym, 
                  "'" << var.GetOriginalName() << "' & '" << info.m_originalName << "'");
    }
    if (left && (info.m_lhsLine == 0))
      info.m_lhsLine = g_lineNumber;
    if (right && (info.m_rhsLine == 0))
      info.m_rhsLine = g_lineNumber;
  }
}

%}

%union {
  char          cval;
  unsigned int  uval;
  int           ival;
  std::string * sval;

  AST::Node            * node;
  AST::Expr            * expr;
  AST::ExprList        * exprList;
  AST::SourceLine      * sourceLine;
  AST::Statement       * statement;
  AST::StatementList   * statementList;
  AST::NumericOperator * oper;
  AST::IfConditional   * ifcond;
  AST::NumericExpr     * numexpr;
  AST::NumericVarRef   * numvarref;

  AST::StringExpr      * strexpr;
  AST::StringVarRef    * strvarref;

  SingleFloat * sfloat;
  DoubleFloat * dfloat;
  std::vector<std::string> * strvec;
}

%token EOL_TOKEN
%token EOF_TOKEN

// operators
%token GREATERTHANEQUAL
%token LESSTHANEQUAL
%token NOT_EQUAL
%token AND_TOKEN

// functions
%token CHR_TOKEN
%token INT_TOKEN
%token LEFT_TOKEN
%token LEN_TOKEN 
%token MID_TOKEN
%token RIGHT_TOKEN
%token SQR_TOKEN
%token STR_TOKEN
%token TAB_TOKEN
%token RND_TOKEN
%token ABS_TOKEN

// commands
%token CLEAR_TOKEN
%token DEF_TOKEN
%token DIM_TOKEN
%token ELSE_TOKEN
%token END_TOKEN
%token FOR_TOKEN
%token IF_TOKEN
%token GOSUB_TOKEN
%token GOTO_TOKEN
%token INPUT_TOKEN
%token LINE_TOKEN
%token LET_TOKEN
%token NEXT_TOKEN
%token OR_TOKEN
%token ON_TOKEN
%token PRINT_TOKEN
%token REM_TOKEN
%token RETURN_TOKEN
%token RUN_TOKEN 
%token STEP_TOKEN
%token SYSTEM_TOKEN
%token STOP_TOKEN
%token THEN_TOKEN
%token TO_TOKEN
%token USING_TOKEN
%token WIDTH_TOKEN

// other lexemes
%token <sval>   IDENTIFIER QUOTED_STRING DEF_INTEGER
%token <sval>   INTEGER_VARNAME STRING_VARNAME SINGLE_VARNAME DOUBLE_VARNAME COMMENT
%token <ival>   INTEGER  
%token <dfloat> DOUBLE 
%token <sfloat> SINGLE

// rules
//%type <sourceLine>    line 
%type <statementList> opt_statement_list statement_list
%type <statementList> opt_ELSE_statement ELSE_statement

%type <statement>    statement statement2
%type <statement>    DIM_statement PRINT_statement WIDTH_statement
%type <statement>    LET_statement FOR_statement GOTO_statement
%type <statement>    IF_statement REM_statement NEXT_statement
%type <statement>    GOSUB_statement RETURN_statement
%type <statement>    DEF_statement INPUT_statement LINE_statement ON_statement
%type <exprList>     dim_var_list
%type <expr>         assign_expression 
%type <ifcond>       conditional_clause 

%type <exprList> print_expression_list input_var_list array_or_func_args
%type <expr>     print_expression input_var

%type <sval>        opt_line_number line_number  opt_COMMENT
%type <ival>        integer

%type <numvarref>  numeric_var_ref numeric_var_name opt_varname 
%type <numexpr>    expression subexpression numeric_const_expr 
%type <numexpr>    numeric_value array_or_func_arg 
%type <numexpr>    AND_expression NOT_expression numeric_compare_expression ADD_expression
%type <numexpr>    MULT_expression NEGATE_expression POWER_expression string_compare_expression 
%type <numexpr>    if_expression opt_STEP_statement
%type <strvec>     opt_def_args def_arg_list opt_on_list

%type <strvarref>  string_var_ref string_var_name
%type <strexpr>    string_value string_expression string_const_expr 
%type <strexpr>    string_subexpression 

%%

file:     /* empty */
          | file line
          ;

/*********************************************************F

 line              

 *********************************************************/ 

line:     opt_line_number 
              {
                g_basicLineNumber = "";
                if ($1 != nullptr) {
                  g_basicLineNumber = *$1;
                  if (AST::g_lineNumberInfo.count(g_basicLineNumber) != 0) {
                    ParserError(Error_DuplicateLineNumber,
                                "duplicate BASIC line number '" << g_basicLineNumber << "' on lines " << g_lexLineNumber << " & " << AST::g_lineNumberInfo[g_basicLineNumber]);
                  }
                  AST::g_lineNumberInfo[g_basicLineNumber] = g_lexLineNumber;
                }
                $<sourceLine>$ = new AST::SourceLine(
                      g_lexLineNumber,
                      g_basicLineNumber, 
                      g_application.GetCurrentLine()
                      );
                g_lineNumber = g_lexLineNumber;
                g_application.SetStatementStart();
              }
          opt_statement_list 
            {
              if (($3 == nullptr) && ($<sourceLine>2->GetBasicLineNumber().empty())) {
                delete $<sourceLine>2;
                delete $3;
              }
              else {
                AST::SourceLine * line = $<sourceLine>2;
                if ($3 != nullptr)
                  line->m_statements.reset($3);
                AST::g_program.Append(line);
              }
            }
          eol
          ;

opt_line_number: /* empty */
                    { 
                      $$ = nullptr;
                    }
                 | line_number
                    { 
                      $$ = $1;
                    }
                 ;

line_number:    DEF_INTEGER
                    {
                      $$ = new std::string(*$1);
                      delete $1;
                    }
                 ; 

integer:    INTEGER
              {
                $$ = $1;
              }
            | DEF_INTEGER
              {
                $$ = strtol($1->c_str(), NULL, 10);
                delete $1;
              }  
            ;                 

opt_statement_list : /* empty */
                      {
                        $$ = nullptr;
                      }
                   | statement_list
                      {
                        $$ = $1;
                      }
                   ;

statement_list : statement2
                  {
                    $$ = new AST::StatementList();
                    if ($1 != nullptr) {
                      if ($1->m_text.empty())
                        $1->m_text = g_application.GetStatement();
                      $$->Append($1);
                    }
                  }   
               | statement_list ':'
                  {
                    g_application.SetStatementStart();
                  } 
                 statement2
                  {
                    if ($4 != nullptr) {
                      $4->m_text = g_application.GetStatement();
                      $1->Append($4);
                    }
                    $$ = $1;
                  }   
               ;

statement2:   { 
              }
              statement
              {
                //cerr << "statement: " << g_application.GetStatement() << endl; 
                $$ = $2;
              } 
              ; 


statement:     CLEAR_statement
                  {
                    $$ = new AST::ClearStatement(g_lexLineNumber);
                  }
               | DEF_statement
                  {
                    $$ = $1;
                  }   
               | DIM_statement
                  {
                    $$ = $1;
                  }   
               | END_statement
                  {
                    $$ = new AST::End(g_lexLineNumber);
                  }   
               | FOR_statement
                  {
                    $$ = $1;
                  }
               | GOTO_statement
                  {
                    $$ = $1;
                  }
               | GOSUB_statement
                  {
                    $$ = $1;
                  }
               | IF_statement
                  {
                    $$ = $1;
                  }
               | INPUT_statement
                  {
                    $$ = $1;
                  }
               | LET_statement
                  {
                    $$ = $1;
                  }
               | LINE_statement
                  {
                    $$ = $1;
                  }
               | NEXT_statement
                  {
                    $$ = $1;
                  }
               | ON_statement
                  {
                    $$ = $1;
                  }   
               | PRINT_statement 
                  {
                    $$ = $1;
                  }
               | REM_statement
                  {
                    $$ = $1;
                  }
               | RUN_statement
                  {
                    ParserError(eError_Parser, "RUN is not supported");
                    $$ = new AST::Rem(g_lexLineNumber, "run");
                  }
               | RETURN_statement
                  {
                    $$ = $1;
                  }
               | STOP_statement
                  {
                    $$ = new AST::End(g_lexLineNumber);
                  }
               | SYSTEM_statement
                  {
                    $$ = new AST::System(g_lexLineNumber);
                  }
               | WIDTH_statement
                  {
                    $$ = $1;
                  }
               | error /* bison error handler */   
                  {
                    $$ = nullptr;
                  }
               ;

eol:    EOL_TOKEN
        | EOF_TOKEN
          { return 0; }  // yes, this is a return!
        ;               

/********************************************************* 

  CLEAR

 *********************************************************/ 

CLEAR_statement: CLEAR_TOKEN
                 ;

/********************************************************* 

  DEF

 *********************************************************/ 

DEF_statement:  DEF_TOKEN IDENTIFIER opt_def_args '=' expression
                {
                  $$ = new AST::DefStatement(g_lexLineNumber, *$2, $3, $5);
                  delete $2;
                }
                ;

opt_def_args: /* empty */
              {
                $$ = new std::vector<std::string>();
              }
              | '(' def_arg_list ')'
              {
                $$ = $2;
              }
              ;

def_arg_list: IDENTIFIER
              {
                AST::NumericVarRef probe(g_languageProfile->GetDefaultNumericType(), *$1);
                $$ = new std::vector<std::string>();
                $$->push_back(probe.GetName());
                delete $1;
              }
              | def_arg_list ',' IDENTIFIER
              {
                AST::NumericVarRef probe(g_languageProfile->GetDefaultNumericType(), *$3);
                $1->push_back(probe.GetName());
                delete $3;
                $$ = $1;
              }
              ;              

/********************************************************* 

  DIM

 *********************************************************/ 

DIM_statement:  DIM_TOKEN dim_var_list
                  {
                    $$ = new AST::DimStatement(g_lexLineNumber, $2);
                  }
                ;

dim_var_list: numeric_var_ref
                {
                  UseNumericGlobalVar(*$1, true, false);
                  $$ = new AST::ExprList();
                  $$->Append($1);
                }
              | dim_var_list ',' numeric_var_ref 
                {
                  UseNumericGlobalVar(*$3, true, false);
                  $1->Append($3);
                  $$ = $1;
                }
              ;

/*********************************************************

 END

 *********************************************************/ 
              
END_statement:  END_TOKEN
                ;

/********************************************************* 

 FOR/NEXT/STEP

 *********************************************************/ 

FOR_statement: FOR_TOKEN numeric_var_ref '=' expression TO_TOKEN expression opt_STEP_statement
                {
                  $$ = new AST::ForStatement(g_lexLineNumber, $2, $4, $6, $7);
                }
                ;

NEXT_statement: NEXT_TOKEN opt_varname
                {   
                  $$ = new AST::NextStatement(g_lexLineNumber, $2);
                }
                ;

opt_varname:    /* empty */
                  {
                    $$ = nullptr;
                  }
                | numeric_var_ref
                  {
                    $$ = $1;
                  }
                ;                

opt_STEP_statement: /* empty */
                      {
                        $$ = nullptr;
                      }
                    | STEP_TOKEN expression
                      {
                        $$ = $2;
                      }
                    ;

/*********************************************************

 GOSUB/RETURN

 *********************************************************/ 
              
GOSUB_statement:  GOSUB_TOKEN line_number
                    {
                      $$ = new AST::GosubStatement(g_lexLineNumber, *$2);
                    }
                ;

RETURN_statement:  RETURN_TOKEN
                    {
                      $$ = new AST::ReturnStatement(g_lexLineNumber);
                    }
                ;

/*********************************************************

 GOTO

 *********************************************************/ 
              
GOTO_statement: GOTO_TOKEN line_number
                  {
                    $$ = new AST::GotoStatement(g_lexLineNumber, *$2);
                    delete $2;
                  }
                ;

/*********************************************************
, 
 IF/THEN/ELSE

 *********************************************************/ 

IF_statement: IF_TOKEN if_expression THEN_TOKEN
                {
                  $<sval>$ = new std::string(g_application.GetStatement());
                  g_application.SetStatementStart();
                }
              conditional_clause opt_ELSE_statement
                {
                  $$ = new AST::IfStatement(g_lexLineNumber, $2, $5, $6);
                  $$->m_text = *$<sval>4;
                  delete $<sval>4;
                }
              ;

if_expression:  expression 
                  {
                    $$ = $1;
                  }
                | string_compare_expression 
                  {
                    $$ = $1;
                  }
                ;              

opt_ELSE_statement:   /* empty */
                        {
                          $$ = nullptr;
                        }
                      | ELSE_statement
                        {
                          $$ = $1;
                        }
                      ;              

ELSE_statement: ELSE_TOKEN
                  {
                    g_application.SetStatementStart();
                  }
                conditional_clause
                  {
                    $$ = $3->m_statements;
                    delete $3;
                  }
                ;

conditional_clause:   line_number
                        {
                          $$ = new AST::IfConditional();
                          $$->m_lineNumber = *$1;
                        }
                      | statement_list
                        {
                          $$ = new AST::IfConditional();
                          $$->m_statements = $1;
                        } 
                      ; 

/********************************************************* 

 INPUT  

 *********************************************************/ 

 LINE_statement:  LINE_TOKEN INPUT_TOKEN QUOTED_STRING ';' string_var_ref
                  {
                    UseStringGlobalVar(*$5, true, false);
                    AST::ExprList * vars = new AST::ExprList();
                    vars->Append($5);
                    $$ = new AST::InputStatement(g_lexLineNumber, *$3, true, vars);
                    delete $3;
                  }
                | LINE_TOKEN INPUT_TOKEN string_var_ref
                  {
                    UseStringGlobalVar(*$3, true, false);
                    AST::ExprList * vars = new AST::ExprList();
                    vars->Append($3);
                    $$ = new AST::InputStatement(g_lexLineNumber, "", true, vars);
                  }
                ;

 INPUT_statement: INPUT_TOKEN QUOTED_STRING ';' input_var_list
                  {
                    $$ = new AST::InputStatement(g_lexLineNumber, *$2, false, $4);
                    delete $2;
                  }
                | INPUT_TOKEN input_var_list
                  {
                    $$ = new AST::InputStatement(g_lexLineNumber, "", false, $2);
                  }
                ;

 input_var_list:  input_var
                  {
                    $$ = new AST::ExprList();
                    $$->Append($1);
                  }
                | input_var_list ',' input_var
                  {
                    $1->Append($3);
                    $$ = $1;
                  }
                ;

 input_var:       numeric_var_ref
                  {
                    UseNumericGlobalVar(*$1, true, false);
                    $$ = $1;
                  }
                | string_var_ref
                  {
                    UseStringGlobalVar(*$1, true, false);
                    $$ = $1;
                  }
                ;       

/********************************************************* 

 LET              

 *********************************************************/ 

LET_statement:  opt_LET_TOKEN assign_expression
                {
                  $$ = new AST::AssignStatement(g_lexLineNumber, $2);
                }
                ;

opt_LET_TOKEN:  /* empty */
                | LET_TOKEN
                ;

assign_expression:  numeric_var_ref '=' expression
                      {
                        UseNumericGlobalVar(*$1, true, false);
                        AST::NumericAssign * ass = new AST::NumericAssign($1, $3);
                        ass->Validate();
                        $$ = ass;
                      }
                    
                    | string_var_ref '=' string_expression
                      {
                        UseStringGlobalVar(*$1, true, false);
                        AST::StringAssign * ass = new AST::StringAssign($1, $3);
                        ass->Validate();
                        $$ = ass;
                      }
                    ;

/********************************************************* 

 ON
 
 *********************************************************/ 

ON_statement:    ON_TOKEN expression GOTO_TOKEN line_number opt_on_list
                  {
                    if ($5 == nullptr)
                      $5 = new std::vector<std::string>();
                    $5->insert($5->begin(), *$4);
                    delete $4;
                    $$ = new AST::OnGotoStatement(g_lexLineNumber, $2, $5);
                  }
                  ;

opt_on_list:     /* empty */
                  {
                    $$ = new std::vector<std::string>();
                  }
                | opt_on_list ',' line_number
                  {
                    $1->push_back(*$3);
                    delete $3;
                    $$ = $1;
                  }
                ;                 

/********************************************************* 

 PRINT              
 
 *********************************************************/   

PRINT_statement:  print_keyword
                    {
                    }
                  opt_USING
                    {
                    }  
                  print_expression_list
                    {
                      $$ = new AST::Print(g_lexLineNumber, $5);
                    }
                  ;

print_keyword:   PRINT_TOKEN
                 | '?'
                    { 
                    }
                 ;

opt_USING:      /* empty */
                | USING_TOKEN string_expression ';'
                ;                       

print_expression_list: /* empty */
                          {
                            $$ = nullptr;
                          }  
                       | print_expression_list print_expression
                          {
                            if ($1 == nullptr)
                              $1 = new AST::ExprList();
                            $1->Append($2);
                            $$ = $1;
                          }
                       ;

print_expression:      expression
                          {
                            $$ = $1;
                          }
                       | string_expression   
                          {
                            $$ = $1;
                          }
                       | ',' 
                          {
                            $$ = new AST::PrintComma();
                          }
                       | ';'
                          {
                            $$ = new AST::PrintSemiColon();
                          }
                       ;                           

/********************************************************* 

 REM              
 
 *********************************************************/ 

REM_statement: rem_keyword 
                  {
                    MBASIC_SetRemMode();
                  }
                opt_COMMENT
                  {
                    if ($3 == nullptr)
                      $$ = nullptr;
                    else   
                      $$ = new AST::Rem(g_lexLineNumber, *$3);
                  }  
               ;

opt_COMMENT:   /* empty */
                  { $$ = nullptr; }
                | COMMENT
                  { $$ = $1; }
                ;                    

rem_keyword: REM_TOKEN
              | '\''
                { 
                  ParserError(eWarning_RemUsingQuote, 
                              "single quote REM not supported in selected language profile"); 
                }
              ;              

/********************************************************* 

 RUN
 
 *********************************************************/ 

RUN_statement: RUN_TOKEN QUOTED_STRING
              ;

/********************************************************* 

 STOP              
 
 *********************************************************/ 

STOP_statement: STOP_TOKEN
                ;

/********************************************************* 

 SYSTEM              
 
 *********************************************************/ 

SYSTEM_statement: SYSTEM_TOKEN
                ;

/********************************************************* 

 WIDTH              
 
 *********************************************************/ 

WIDTH_statement: WIDTH_TOKEN integer
                  {
                    $$ = new AST::WidthStatement(g_lexLineNumber, $2);
                  }
                  ;

/********************************************************* 

 expression              

 *********************************************************/ 

expression: AND_expression OR_TOKEN expression
              {
                $$ = new AST::LogicalOr($1, $3);
              }
            | AND_expression
              {
                $$ = $1;
              }  
            ;

AND_expression: NOT_expression AND_TOKEN AND_expression
                  {
                    $$ = new AST::LogicalAnd($1, $3);
                  }
                | NOT_expression
                  {
                    $$ = $1;
                  }
                ;

NOT_expression: '-' numeric_compare_expression
                  {
                    $$ = new AST::Negation($2);
                  }
                | numeric_compare_expression
                  {
                    $$ = $1;
                  }
                | string_compare_expression  
                  {
                    $$ = $1;
                  }
                ;

numeric_compare_expression: ADD_expression '=' numeric_compare_expression
                      {
                        $$ = new AST::NumericEquality($1, $3);
                      }
                    | ADD_expression NOT_EQUAL numeric_compare_expression
                      {
                        $$ = new AST::NumericNotEquality($1, $3);
                      }
                    | ADD_expression '>' numeric_compare_expression
                      {
                        $$ = new AST::NumericGreaterThan($1, $3);
                      }
                    | ADD_expression GREATERTHANEQUAL numeric_compare_expression
                      {
                        $$ = new AST::NumericGreaterThanEqual($1, $3);
                      }
                    | ADD_expression '<' numeric_compare_expression
                      {
                        $$ = new AST::NumericLessThan($1, $3);
                      }
                    | ADD_expression LESSTHANEQUAL numeric_compare_expression
                      {
                        $$ = new AST::NumericLessThanEqual($1, $3);
                      }
                    | ADD_expression 
                      {
                        $$ = $1;
                      }
                    ;

ADD_expression: ADD_expression '+' MULT_expression
                  { 
                    AST::NumericAddition * op = new AST::NumericAddition($1, $3);
                    op->Validate();
                    $$ = op;
                  }
                | ADD_expression '-' MULT_expression
                  { 
                    AST::Subtraction * op = new AST::Subtraction($1, $3);
                    op->Validate();
                    $$ = op;
                  }
                | MULT_expression
                  {
                    $$ = $1;
                  }  
                ;

MULT_expression:  MULT_expression '*' NEGATE_expression
                    { 
                      AST::Multiplication * op = new AST::Multiplication($1, $3);;
                      op->Validate();
                      $$ = op;
                    }
                  | MULT_expression '/' NEGATE_expression
                    { 
                      AST::Division * op = new AST::Division($1, $3);
                      op->Validate();
                      $$ = op;
                    }  
                  | NEGATE_expression
                    {
                      $$ = $1;  
                    } 
                  ;   
                          
NEGATE_expression:  '-' POWER_expression
                      {
                        $$ = new AST::Negation($2);  
                      }
                    | '+' POWER_expression
                      {
                        $$ = $2;
                      }
                    | POWER_expression
                      {
                        $$ = $1;
                      }
                    ;  

POWER_expression: POWER_expression '^' subexpression
                    {
                      AST::Power * op = new AST::Power($1, $3);
                      op->Validate();
                      $$ = op;
                    }
                  | subexpression
                      {
                        $$ = $1;
                      }
                  ;

subexpression: '(' expression ')'
                  {
                    $$ = $2;
                  }
                | numeric_value
                  {
                    $$ = $1;
                  }
                ;                          

numeric_value:  numeric_var_ref
                  {
                    UseNumericGlobalVar(*$1, false, true);
                    $$ = $1;
                  }
                | INT_TOKEN '(' expression ')'  
                  {
                    $$ = new AST::IntFunction($3);
                  }
                | SQR_TOKEN '(' expression ')'  
                  {
                    $$ = new AST::SqrFunction($3);
                  }
                | LEN_TOKEN '(' string_expression ')'  
                  {
                    $$ = new AST::LenFunction($3);
                  }
                | RND_TOKEN '(' expression ')'
                  {
                    $$ = new AST::RndFunction($3);
                  }
                | ABS_TOKEN '(' expression ')'
                  {
                    $$ = new AST::AbsFunction($3);
                  }
                | numeric_const_expr
                  {
                    $$ = $1;
                  }
                ;  

/********************************************************* 

 string expression              

 *********************************************************/ 

string_compare_expression: string_expression '=' string_expression
                      {
                        $$ = new AST::StringCompare($1, $3, true);
                      }
                    | string_expression NOT_EQUAL string_expression
                      {
                        $$ = new AST::StringCompare($1, $3, false);
                      }
                    ;  
                      
string_expression: string_subexpression '+' string_expression
                        { 
                          $$ = new AST::StringAddition($1, $3);
                        }
                       | string_subexpression 
                        { 
                          $$ = $1;
                        }
                      ;

string_subexpression: '(' string_expression ')'
                  {
                    $$ = $2;
                  }
                | string_value
                  {
                    $$ = $1;
                  }
                ;

string_value:   string_var_ref
                  {
                    $$ = $1;
                  }
                | CHR_TOKEN '(' expression ')'  
                  {
                    $$ = new AST::ChrFunction($3);
                  }
                | LEFT_TOKEN '(' string_expression ',' expression ')'  
                  {
                    $$ = new AST::LeftFunction($3, $5);
                  }
                | MID_TOKEN '(' string_expression ',' expression ',' expression ')'  
                  {
                    $$ = new AST::MidFunction($3, $5, $7);
                  }
                | RIGHT_TOKEN '(' string_expression ',' expression ')'  
                  {
                    $$ = new AST::RightFunction($3, $5);
                  }
                | STR_TOKEN '(' expression ')'  
                  {
                    $$ = new AST::StrFunction($3);
                  }                  
                | TAB_TOKEN '(' expression ')'  
                  {
                    $$ = new AST::TabFunction($3);
                  }
                | string_const_expr
                  {
                    $$ = $1;
                  }
                ;  

/********************************************************* 

numeric var or numeric array ref              
 
 *********************************************************/

numeric_var_ref : numeric_var_name
            {
              $$ = $1;
            }
          | numeric_var_name '(' array_or_func_args ')'
            {
              $$ = new AST::NumericSubscript($1, $3);
            }
          ;

numeric_var_name: IDENTIFIER
            {
              $$ = new AST::NumericVarRef(g_languageProfile->GetDefaultNumericType(), *$1);
              delete $1;
            }
          | INTEGER_VARNAME
            {
              $$ = new AST::NumericVarRef(g_languageProfile->GetIntegerType(), *$1);
              delete $1;
            }
          | SINGLE_VARNAME
            {
              $$ = new AST::NumericVarRef(VarType::eSingle, *$1);
              delete $1;
            }
          | DOUBLE_VARNAME
            {
              $$ = new AST::NumericVarRef(VarType::eDouble, *$1);
              delete $1;
            }
          ;

string_var_ref : string_var_name
                  {
                    $$ = $1;
                  }
                | string_var_name '(' array_or_func_args ')'
                  {
                    $$ = $1;
                    delete $3;
                  }
                ;

string_var_name: STRING_VARNAME
            {
              $$ = new AST::StringVarRef(*$1);
              delete $1;
            }
            ;

array_or_func_spec: '(' array_or_func_args ')'
                      {
                      }
                    ; 

array_or_func_args: array_or_func_arg 
                      {
                        $$ = new AST::ExprList();
                        $$->Append($1);
                      }
                    | array_or_func_args ',' array_or_func_arg   
                      {
                        $1->Append($3);
                        $$ = $1;
                      }
                    ;

array_or_func_arg:  expression
                      {
                      }
                    /*| string_expression
                      {
                      }
                    */
                    ;

/********************************************************* 

 miscellaneous              
 
 *********************************************************/ 

numeric_const_expr: INTEGER
              {
                stringstream strm;
                strm << $1;
                $$ = CreateConstant(g_languageProfile->GetIntegerType(), strm.str());
              }
            | DEF_INTEGER  
              {
                // count significant digits
                int s = 0;
                for (auto & c : *$1)
                  if (isdigit(c))
                    s++;
                int32_t v = strtoul($1->c_str(), nullptr, 10);
                if (
                    (g_languageProfile->GetDefaultNumericType() == VarType::eInt16) && 
                    (v <= 32767) && 
                    (v >= -32768)
                   ) {
                  $$ = CreateConstant(VarType::eInt16, *$1);
                }
                else if (
                    (g_languageProfile->GetDefaultNumericType() == VarType::eInt32) && 
                    (v <= 2147483647) && 
                    (v >= -214748368)
                  ) {
                  $$ = CreateConstant(VarType::eInt32, *$1);
                } 
                else if (s <= 7) {
                  $$ = CreateConstant(VarType::eSingle, *$1);
                }
                else {
                  $$ = CreateConstant(VarType::eDouble, *$1);
                }
                delete $1;
              }
            | DOUBLE
              {
                $$ = new AST::DoubleConstant($1->m_value);
                delete $1;
              }
            | SINGLE
              {
                $$ = new AST::SingleConstant($1->m_value);
                delete $1;
              }
            ;

string_const_expr: QUOTED_STRING
              {
                $$ = new AST::StringConstant(*$1);
                delete $1;
              }
            ;
