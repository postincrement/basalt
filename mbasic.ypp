%name-prefix "MBASIC_" 
%define parse.error verbose

%{

#include <iostream>
#include <string>
#include <sstream>
#include <memory>
using namespace std;

#include "common.h"
#include "basalt.h"

#define YYDEBUG 1

static unsigned g_lineNumber = 1;

extern void MBASIC_SetRemMode();

void MBASIC_error(const char * msg)
{
  g_application.OnError(g_lineNumber, msg);
}

static AST::NumericExpr * CreateConstant(VarType type, const std::string & val)
{
  switch (type) {
    case VarType::eInt16:
      return AST::Int16Constant::Create(val);
    case VarType::eInt32:
      return AST::Int32Constant::Create(val);
    case VarType::eSingle:
      return AST::SingleConstant::Create(val);
    case VarType::eDouble:
      return AST::DoubleConstant::Create(val);
    case VarType::eString:
      return nullptr;
  }
}

static void UseNumericGlobalVar(AST::NumericVarRef & var, bool left, bool right)
{
  if (AST::g_globalVars.count(var.GetName()) == 0) {
    AST::VarInfo info;
    info.m_type         = var.GetType();
    info.m_originalName = var.GetOriginalName(); 
    if (left)
      info.m_lhsLine = g_lineNumber;
    if (right)   
      info.m_rhsLine  = g_lineNumber;
    AST::g_globalVars[var.GetName()] = info;
  }
  else {
    AST::VarInfo & info = AST::g_globalVars[var.GetName()];
    if (var.GetOriginalName() != info.m_originalName) {
      SourceWarning(eWarning_VarIsSynonym, g_lineNumber, "'" << var.GetOriginalName() << "' & '" << info.m_originalName << "'");
    }
    if (left && (info.m_lhsLine == 0))
      info.m_lhsLine = g_lineNumber;
    if (right && (info.m_rhsLine == 0))
      info.m_rhsLine = g_lineNumber;
  }
}

static void UseStringGlobalVar(AST::StringVarRef & var, bool left, bool right)
{
  if (AST::g_globalVars.count(var.GetName()) == 0) {
    AST::VarInfo info;
    info.m_type         = var.GetType();
    info.m_originalName = var.GetOriginalName(); 
    if (left)
      info.m_lhsLine = g_lineNumber;
    if (right)   
      info.m_rhsLine  = g_lineNumber;
    AST::g_globalVars[var.GetName()] = info;
  }
  else {
    AST::VarInfo & info = AST::g_globalVars[var.GetName()];
    if (var.GetOriginalName() != info.m_originalName) {
      SourceWarning(eWarning_VarIsSynonym, g_lineNumber, "'" << var.GetOriginalName() << "' & '" << info.m_originalName << "'");
    }
    if (left && (info.m_lhsLine == 0))
      info.m_lhsLine = g_lineNumber;
    if (right && (info.m_rhsLine == 0))
      info.m_rhsLine = g_lineNumber;
  }
}

%}

%union {
  char          cval;
  unsigned int  uval;
  int           ival;
  std::string * sval;

  AST::Node            * node;
  AST::Expr            * expr;
  AST::ExprList        * exprList;
  AST::SourceLine      * sourceLine;
  AST::Statement       * statement;
  AST::StatementList   * statementList;
  AST::NumericOperator * oper;

  AST::NumericExpr     * numexpr;
  AST::NumericVarRef   * numvarref;

  AST::StringExpr      * strexpr;
  AST::StringVarRef    * strvarref;

  SingleFloat * sfloat;
  DoubleFloat * dfloat;
}

%token EOL_TOKEN
%token EOF_TOKEN

// operators
%token GREATERTHANEQUAL
%token LESSTHANEQUAL
%token NOT_EQUAL
%token AND_TOKEN

// functions
%token CHR_TOKEN
%token INT_TOKEN
%token LEFT_TOKEN 
%token MID_TOKEN
%token RIGHT_TOKEN
%token SQR_TOKEN
%token STR_TOKEN
%token TAB_TOKEN

// commands
%token CLEAR_TOKEN
%token DEF_TOKEN
%token DIM_TOKEN
%token ELSE_TOKEN
%token END_TOKEN
%token FOR_TOKEN
%token IF_TOKEN
%token GOSUB_TOKEN
%token GOTO_TOKEN
%token INPUT_TOKEN
%token LET_TOKEN
%token NEXT_TOKEN
%token OR_TOKEN
%token ON_TOKEN
%token PRINT_TOKEN
%token REM_TOKEN
%token RETURN_TOKEN
%token RUN_TOKEN 
%token STEP_TOKEN
%token SYSTEM_TOKEN
%token STOP_TOKEN
%token THEN_TOKEN
%token TO_TOKEN
%token USING_TOKEN
%token WIDTH_TOKEN

// other lexemes
%token <sval>   IDENTIFIER QUOTED_STRING DEF_NUMERIC
%token <sval>   INTEGER_VARNAME STRING_VARNAME SINGLE_VARNAME DOUBLE_VARNAME
%token <ival>   INTEGER  
%token <dfloat> DOUBLE 
%token <sfloat> SINGLE

// rules
//%type <sourceLine>    line 
%type <statementList> opt_statement_list statement_list
 
%type <statement>    statement
%type <statement>    DIM_statement PRINT_statement WIDTH_statement
%type <statement>    LET_statement FOR_statement GOTO_statement
%type <exprList>     dim_var_list
%type <expr>         assign_expression 

%type <exprList> print_expression_list 
%type <expr>     print_expression

%type <sval>        opt_line_number line_number
%type <ival>        integer

%type <numvarref>  numeric_var_ref numeric_var_name 
%type <numexpr>    expression subexpression numeric_const_expr 
%type <numexpr>    numeric_value array_or_func_arg 
%type <numexpr>    AND_expression NOT_expression compare_expression ADD_expression
%type <numexpr>    MULT_expression NEGATE_expression POWER_expression

%type <strvarref>  string_var_ref string_var_name
%type <strexpr>    string_value string_expression string_const_expr 
%type <strexpr>    string_ADD_expression string_subexpression 

%%

file:     /* empty */
          | file line
          ;

/*********************************************************F

 line              

 *********************************************************/ 

line:     opt_line_number 
              {
                std::string basicLineNumber;
                if ($1 != nullptr) {
                  basicLineNumber = *$1;
                  AST::g_lineNumberInfo[basicLineNumber] = g_lexLineNumber;
                }
                $<sourceLine>$ = new AST::SourceLine(
                      g_lexLineNumber,
                      basicLineNumber, 
                      g_application.GetCurrentLine()
                      );
                g_lineNumber = g_lexLineNumber;     
              }
          opt_statement_list 
            {
              AST::SourceLine * line = $<sourceLine>2;
              if ($3 != nullptr)
                line->m_statements.reset($3);
              AST::g_program.Append(line);
              /*cerr << "line " 
                   << line->GetSourceLineNumber()
                   << ": " << line->GetLine() << "\n";*/      
            }
          eol
          ;

opt_line_number: /* empty */
                    { 
                      $$ = nullptr;
                    }
                 | line_number
                    { 
                      $$ = $1;
                    }
                 ;

line_number:    DEF_NUMERIC
                    {
                      $$ = new std::string(*$1);
                      delete $1;
                    }
                 ; 

integer:    INTEGER
              {
                $$ = $1;
              }
            ;                 

opt_statement_list : /* empty */
                      {
                        $$ = nullptr;
                      }
                   | statement_list
                      {
                        $$ = $1;
                      }
                   ;

statement_list : statement
                  {
                    $$ = new AST::StatementList();
                    $$->Append($1);
                  }   
               | statement_list ':' statement
                  {
                    $1->Append($3);
                    $$ = $1;
                  }   
               ;

statement:     CLEAR_statement
                  {
                    $$ = nullptr;
                  }
               | DEF_statement
                  {
                    $$ = nullptr;
                  }   
               | DIM_statement
                  {
                    $$ = $1;
                  }   
               | END_statement
                  {
                    $$ = nullptr;
                  }   
               | FOR_statement
                  {
                    $$ = $1;
                  }
               | GOTO_statement
                  {
                    $$ = $1;
                  }
               | GOSUB_statement
                  {
                    $$ = nullptr;
                  }
               | IF_statement
                  {
                    $$ = nullptr;
                  }
               | INPUT_statement
                  {
                    $$ = nullptr;
                  }
               | LET_statement
                  {
                    $$ = $1;
                  }
               | NEXT_statement
                  {
                    $$ = nullptr;
                  }
               | ON_statement
                  {
                    $$ = nullptr;
                  }   
               | PRINT_statement 
                  {
                    $$ = $1;
                  }
               | REM_statement
                  {
                    $$ = nullptr;
                  }
               | RUN_statement
                  {
                    $$ = nullptr;
                  }
               | RETURN_statement
                  {
                    $$ = nullptr;
                  }
               | STOP_statement
                  {
                    $$ = nullptr;
                  }
               | SYSTEM_statement
                  {
                    $$ = nullptr;
                  }
               | WIDTH_statement
                  {
                    $$ = nullptr;
                  }
               | error /* bison error handler */   
                  {
                    $$ = nullptr;
                  }
               ;

eol:    EOL_TOKEN
        | EOF_TOKEN
          { return 0; }  // yes, this is a return!
        ;               

/********************************************************* 

  CLEAR

 *********************************************************/ 

CLEAR_statement: CLEAR_TOKEN expression
                 ;

/********************************************************* 

  DEF

 *********************************************************/ 

DEF_statement:  DEF_TOKEN IDENTIFIER opt_def_args '=' expression 
                ;

opt_def_args: /* empty */
              | '(' def_arg_list ')'
              ;

def_arg_list: IDENTIFIER 
              | def_arg_list ',' IDENTIFIER
              ;              

/********************************************************* 

  DIM

 *********************************************************/ 

DIM_statement:  DIM_TOKEN dim_var_list
                  {
                    $$ = new AST::Statement();
                    $$->Append($2);
                  }
                ;

dim_var_list: numeric_var_ref
                {
                }
              | dim_var_list ',' numeric_var_ref 
                {
                }
              ;

/*********************************************************

 END

 *********************************************************/ 
              
END_statement:  END_TOKEN
                ;

/********************************************************* 

 FOR/NEXT/STEP

 *********************************************************/ 

FOR_statement: FOR_TOKEN numeric_var_ref '=' expression TO_TOKEN expression opt_STEP_statement
                {
                  $$ = nullptr;
                }
                ;

NEXT_statement: NEXT_TOKEN opt_varname
                ;

opt_varname:    /* empty */
                | numeric_var_ref
                ;                

opt_STEP_statement: /* empty */
                    | STEP_TOKEN expression
                    ;

/*********************************************************

 GOSUB/RETURN

 *********************************************************/ 
              
GOSUB_statement:  GOSUB_TOKEN line_number
                ;

RETURN_statement:  RETURN_TOKEN
                ;

/*********************************************************

 GOTO

 *********************************************************/ 
              
GOTO_statement: GOTO_TOKEN line_number
                  {
                    auto & info = AST::g_gotoInfo[*$2];
                    info.m_count++;
                    info.m_usedLine.insert(g_lineNumber);
                    $$ = new AST::Goto(*$2);
                    delete $2;
                  }
                ;

/*********************************************************

 IF/THEN/ELSE

 *********************************************************/ 

IF_statement: IF_TOKEN expression THEN_TOKEN conditional_clause opt_ELSE_statement
              ;

opt_ELSE_statement:   /* empty */
                      | ELSE_statement
                      ;              

ELSE_statement: ELSE_TOKEN conditional_clause
                ;

conditional_clause:   line_number
                      | statement_list 
                      ; 

/********************************************************* 

 INPUT  

 *********************************************************/ 

 INPUT_statement: INPUT_TOKEN QUOTED_STRING ';' input_var_list
                  | INPUT_TOKEN input_var_list
                  ;

 input_var_list:  input_var
                  | input_var_list ',' input_var
                  ;

 input_var:       numeric_var_ref
                  ;       

/********************************************************* 

 LET              

 *********************************************************/ 

LET_statement:  opt_LET_TOKEN assign_expression
                {
                  $$ = new AST::Statement();
                  $$->Append($2);
                }
                ;

opt_LET_TOKEN:  /* empty */
                | LET_TOKEN
                ;

assign_expression:  numeric_var_ref '=' expression
                      {
                        UseNumericGlobalVar(*$1, true, false);
                        AST::NumericAssign * ass = new AST::NumericAssign($1, $3);
                        ass->Validate();
                        $$ = ass;
                      }
                    
                    | string_var_ref '=' string_expression
                      {
                        UseStringGlobalVar(*$1, true, false);
                        AST::StringAssign * ass = new AST::StringAssign($1, $3);
                        ass->Validate();
                        $$ = ass;
                      }
                    ;

/********************************************************* 

 ON
 
 *********************************************************/ 

ON_statement:    ON_TOKEN expression GOTO_TOKEN line_number opt_on_list
                  ;

opt_on_list:     /* empty */
                  | ',' line_number opt_on_list
                  ;                 

/********************************************************* 

 PRINT              
 
 *********************************************************/   

PRINT_statement:  print_keyword
                    {
                    }
                  opt_USING
                    {
                    }  
                  print_expression_list
                    {
                      $$ = new AST::Print($5);
                    }
                  ;

print_keyword:   PRINT_TOKEN
                 | '?'
                    { 
                    }
                 ;

opt_USING:      /* empty */
                | USING_TOKEN expression ';'
                ;                       

print_expression_list: /* empty */
                          {
                            $$ = nullptr;
                          }  
                       | print_expression_list print_expression
                          {
                            if ($1 == nullptr)
                              $1 = new AST::ExprList();
                            $1->Append($2);
                            $$ = $1;
                          }
                       ;

print_expression:      expression
                          {
                            $$ = $1;
                          }
                       | string_expression   
                          {
                            $$ = $1;
                          }
                       | ',' 
                          {
                            $$ = new AST::PrintComma();
                          }
                       | ';'
                          {
                            $$ = new AST::PrintSemiColon();
                          }
                       ;                           

/********************************************************* 

 REM              
 
 *********************************************************/ 

REM_statement: rem_keyword
                  {
                    MBASIC_SetRemMode();
                  }
               ;

 rem_keyword: REM_TOKEN
              | '\''
                { 
                  Warning(eWarning_RemUsingQuote, "single quote REM not supported in selected language profile"); 
                }
              ;              

/********************************************************* 

 RUN
 
 *********************************************************/ 

RUN_statement: RUN_TOKEN QUOTED_STRING
              ;

/********************************************************* 

 STOP              
 
 *********************************************************/ 

STOP_statement: STOP_TOKEN
                ;

/********************************************************* 

 SYSTEM              
 
 *********************************************************/ 

SYSTEM_statement: SYSTEM_TOKEN
                ;

/********************************************************* 

 WIDTH              
 
 *********************************************************/ 

WIDTH_statement: WIDTH_TOKEN integer
                  {
                  }
               ;

/********************************************************* 

 expression              

 *********************************************************/ 

expression: AND_expression OR_TOKEN expression
              {
                $$ = nullptr;
              }
            | AND_expression
              {
                $$ = $1;
              }  
            ;

AND_expression: NOT_expression AND_TOKEN AND_expression
                  {
                    $$ = nullptr;
                  }
                | NOT_expression
                  {
                    $$ = $1;
                  }
                ;

NOT_expression: '-' compare_expression
                  {
                    $$ = nullptr;
                  }
                | compare_expression
                  {
                    $$ = $1;
                  }
                ;

compare_expression: ADD_expression '=' compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression NOT_EQUAL compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression '>' compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression GREATERTHANEQUAL compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression '<' compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression LESSTHANEQUAL compare_expression
                      {
                        $$ = nullptr;
                      }
                    | ADD_expression 
                      {
                        $$ = $1;
                      }
                    ;

ADD_expression: MULT_expression '+' ADD_expression
                  { 
                    AST::NumericAddition * op = new AST::NumericAddition($1, $3);
                    op->Validate();
                    $$ = op;
                  }
                | MULT_expression '-' ADD_expression
                  { 
                    AST::Subtraction * op = new AST::Subtraction($1, $3);;
                    op->Validate();
                    $$ = op;
                  }
                | MULT_expression
                  {
                    $$ = $1;
                  }  
                ;

MULT_expression:  NEGATE_expression '*' MULT_expression
                    { 
                      AST::Multiplication * op = new AST::Multiplication($1, $3);;
                      op->Validate();
                      $$ = op;
                    }
                  | NEGATE_expression '/' MULT_expression
                    { 
                      AST::Division * op = new AST::Division($1, $3);
                      op->Validate();
                      $$ = op;
                    }  
                  | NEGATE_expression
                    {
                      $$ = $1;  
                    } 
                  ;   
                          
NEGATE_expression:  '-' POWER_expression
                      {
                        $$ = new AST::Negation($2);  
                      }  
                    | POWER_expression
                      {
                        $$ = $1;
                      }
                    ;  

POWER_expression: POWER_expression '^' subexpression
                    {
                      $$ = new AST::Power($3);
                    }
                  | subexpression
                      {
                        $$ = $1;
                      }
                  ;

subexpression: '(' expression ')'
                  {
                    $$ = $2;
                  }
                | numeric_value
                  {
                    $$ = $1;
                  }
                ;                          

numeric_value:  numeric_var_ref
                  {
                    UseNumericGlobalVar(*$1, false, true);
                    $$ = $1;
                  }
                | INT_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | SQR_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | TAB_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | numeric_const_expr
                  {
                    $$ = $1;
                  }
                ;  

/********************************************************* 

 string expression              

 *********************************************************/ 

string_expression: string_value
                      {
                        $$ = $1;
                      }
                    ;

string_expression: string_ADD_expression '=' string_expression
                      {
                        $$ = nullptr;
                      }
                    | string_ADD_expression NOT_EQUAL string_expression
                      {
                        $$ = nullptr;
                      }
                    ;  
                      
string_ADD_expression: string_subexpression '+' string_ADD_expression
                        { 
                          $$ = nullptr;
                        }
                       | string_subexpression 
                        { 
                          $$ = $1;
                        }
                        ;

string_subexpression: '(' string_expression ')'
                  {
                    $$ = $2;
                  }
                | string_value
                  {
                    $$ = $1;
                  }
                ;

string_value:   string_var_ref
                  {
                    $$ = $1;
                  }

                | CHR_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | LEFT_TOKEN '(' string_expression ',' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | MID_TOKEN '(' string_expression ',' expression ',' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | RIGHT_TOKEN '(' string_expression ',' expression ')'  
                  {
                    $$ = nullptr;
                  }
                | STR_TOKEN '(' expression ')'  
                  {
                    $$ = nullptr;
                  }                  
                | string_const_expr
                  {
                    $$ = $1;
                  }
                ;  

/********************************************************* 

numeric var or numeric array ref              
 
 *********************************************************/

numeric_var_ref : numeric_var_name
            {
              $$ = $1;
            }
          | numeric_var_name array_or_func_spec
            {
            }
          ;

numeric_var_name: IDENTIFIER
            {
              $$ = new AST::NumericVarRef(g_languageProfile->GetDefaultNumericType(), *$1);
              delete $1;
            }
          | INTEGER_VARNAME
            {
              $$ = new AST::NumericVarRef(g_languageProfile->GetIntegerType(), *$1);
              delete $1;
            }
          | SINGLE_VARNAME
            {
              $$ = new AST::NumericVarRef(VarType::eSingle, *$1);
              delete $1;
            }
          | DOUBLE_VARNAME
            {
              $$ = new AST::NumericVarRef(VarType::eDouble, *$1);
              delete $1;
            }
          ;

string_var_ref : string_var_name
                  {
                    $$ = $1;
                  }
                | string_var_name array_or_func_spec
                  {
                  }
                ;

string_var_name: STRING_VARNAME
            {
              $$ = new AST::StringVarRef(VarType::eString, *$1);
              delete $1;
            }
            ;

array_or_func_spec: '(' array_or_func_args ')'
                      {
                      }
                    ; 

array_or_func_args: array_or_func_arg 
                      {
                      }
                    | array_or_func_args ',' array_or_func_arg   
                      {
                      }
                    ;

array_or_func_arg:  expression
                      {
                      }
                    /*| string_expression
                      {
                      }
                    */
                    ;

/********************************************************* 

 miscellaneous              
 
 *********************************************************/ 

numeric_const_expr: INTEGER
              {
                stringstream strm;
                strm << $1;
                $$ = CreateConstant(g_languageProfile->GetIntegerType(), strm.str());
              }
            | DEF_NUMERIC  
              {
                $$ = CreateConstant(g_languageProfile->GetDefaultNumericType(), *$1);
                delete $1;
              }
            | DOUBLE
              {
                $$ = new AST::DoubleConstant($1->m_value);
                delete $1;
              }
            | SINGLE
              {
                $$ = new AST::SingleConstant($1->m_value);
                delete $1;
              }
            ;

string_const_expr: QUOTED_STRING
              {
                $$ = new AST::StringConstant(*$1);
                delete $1;
              }
            ;
