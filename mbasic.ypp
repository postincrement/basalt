%name-prefix "MBASIC_" 

%{

#include <iostream>
#include <string>
#include <sstream>
using namespace std;

#include "basalt.h"

#define YYDEBUG 1

extern void MBASIC_SetRemMode();

%}

%union {
  char          cval;
  unsigned int  uval;
  int           ival;
  double        fval;
  std::string * sval;

  CodeGenerator::ASTExpr     * expr;
  CodeGenerator::ASTExprList * exprlist;
  CodeGenerator::Variable    * varname;

  PrintElement               * printel;
  PrintElementList           * printellist; 
}

%token EOL_TOKEN
%token EOF_TOKEN
%token LET_TOKEN
%token PRINT_TOKEN
%token REM_TOKEN

%token <sval> IDENTIFIER INTEGER_VARNAME STRING_VARNAME
%token <sval> QUOTED_STRING
%token <uval> POSITIVE_INT
%token <ival> NEGATIVE_INT
%token <fval> DOUBLE

%type <ival>     integer

%type <expr>        PRINT_statement 
%type <printel>     print_expression 
%type <printellist> print_expression_list 

%type <expr>     LET_statement assign_expression numeric_expression string_expression string_constant

%%

MBASIC_file: line
             | MBASIC_file line 
             ;

/*********************************************************F

 line              

 *********************************************************/ 

line:     opt_line_number opt_statement_list eol
          ;

opt_line_number: /* empty */
                 | POSITIVE_INT
                 ; 

opt_statement_list : /* empty */
                   | statement_list
                   ;

statement_list : statement
               | statement_list ':' statement
               ;

statement:     LET_statement
               | PRINT_statement 
               | REM_statement
               ;

eol:    EOL_TOKEN
        | EOF_TOKEN
        { return 0; }
        ;               

/********************************************************* 

 LET              

 *********************************************************/ 

LET_statement:  opt_LET_TOKEN assign_expression
                {
                  g_expressions.push_back($2);
                }
                ;

opt_LET_TOKEN:  /* empty */
                | LET_TOKEN
                ;

assign_expression:  IDENTIFIER '=' numeric_expression
                        {
                          CodeGenerator::Variable * var = g_globals.Add<CodeGenerator::Int16Variable>(*$1, true);
                          if (var == NULL) {
                            cerr << "Variable '" << *$1 << " redefined type" << endl;
                            $$ = nullptr;
                            delete $1;
                          }
                          else {
                            $$ = new CodeGenerator::NumericAssignExpr(var, $3);
                          }
                        }
                    | INTEGER_VARNAME '=' numeric_expression
                        {
                          CodeGenerator::Variable * var = g_globals.Add<CodeGenerator::Int16Variable>(*$1, true);
                          if (var == NULL) {
                            cerr << "Variable '" << *$1 << " redefined type" << endl;
                            $$ = nullptr;
                            delete $1;
                          }  
                          else
                            $$ = new CodeGenerator::NumericAssignExpr(var, $3);
                        }
                    | STRING_VARNAME '=' string_expression
                        {
                          CodeGenerator::Variable * var = g_globals.Add<CodeGenerator::StringVariable>(*$1, true);
                          if (var == NULL) {
                            cerr << "Variable '" << *$1 << " redefined type" << endl;
                            $$ = nullptr;
                            delete $1;
                          }
                          else 
                            $$ = new CodeGenerator::StringAssignExpr(var, $3);
                        }
                    ;

numeric_expression: integer
                        { $$ = new CodeGenerator::ConstantInt16Expr($1); }
                    | DOUBLE
                        { $$ = new CodeGenerator::ConstantInt16Expr($1);}
                    ;

string_expression:  string_constant
                    {
                      $$ = $1; 
                    }
                    ;

/********************************************************* 

 PRINT              
 
 *********************************************************/ 

PRINT_statement:  print_keyword print_expression_list
                    {
                      for (auto & r : *$2) {
                        CodeGenerator::ASTExpr * expr = nullptr;
                        if (r->m_isTab)
                          expr = new CodeGenerator::Call0Expr("basalt_puts_tab");
                        else if (r->m_expr != nullptr)  
                          expr = r->m_expr;
                        if (expr != nullptr)  
                          g_expressions.push_back(expr);
                      }
                      size_t len = $2->size();
                      if ((len > 0) && !(*$2)[len-1]->m_isTab && ((*$2)[len-1]->m_expr != nullptr)) 
                        g_expressions.push_back(new CodeGenerator::Call0Expr("basalt_puts_eol"));
                    }
                 ;

print_keyword:   PRINT_TOKEN
                 | '?'
                 { cout << "warning: question mark PRINT not supported in basic-8k" << endl; }
                 ;                 

print_expression_list: /* empty */
                          {
                            $$ = new PrintElementList;
                          }  
                       | print_expression_list print_expression
                          {
                            if ($1 != nullptr) {
                              $1->push_back($2);
                              $$ = $1;
                            }
                          }
                       ;

print_expression:      string_constant
                          {
                            $$ = new PrintElement();
                            $$->m_expr = new CodeGenerator::Call1Expr<CodeGenerator::GetPtrToInt8Ty>(
                                     "basalt_puts_string", 
                                     $1
                                     );
                          }
                       | IDENTIFIER
                         {
                            $$ = new PrintElement();
                            $$->m_expr = new CodeGenerator::Call1Expr<CodeGenerator::GetPtrToInt8Ty>(
                                     "basalt_puts_string", 
                                     new CodeGenerator::ConstantStringExpr(*$1, true)
                                     );
                            delete $1;         
                         }
                       | ',' 
                          {
                            $$ = new PrintElement();
                            $$->m_isTab = true;
                          }
                       | ';'
                          {
                            $$ = new PrintElement();
                            $$->m_expr = nullptr;
                          }
                       ;                           

/********************************************************* 

 REM              
 
 *********************************************************/ 

REM_statement: rem_keyword
                  {
                    MBASIC_SetRemMode();
                  }
               ;

 rem_keyword: REM_TOKEN
              | '\''
                { cout << "warning: single quote REM not supported in basic-8k" << endl; }
              ;              


/********************************************************* 

 miscellaneous              
 
 *********************************************************/ 

integer:        POSITIVE_INT
                | NEGATIVE_INT
                ;

string_constant:    QUOTED_STRING
                    {
                      auto r = m_globalStringConstants.find(*$1);
                      if (r != m_globalStringConstants.end())
                        $$ = r->second;
                      else {
                        auto * expr = new CodeGenerator::ConstantStringExpr(*$1, true);
                        m_globalStringConstants[*$1] = expr;
                        $$ = expr;
                      }  
                      delete $1;  
                    }                    


