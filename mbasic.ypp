%name-prefix "MBASIC_" 
%define parse.error verbose

%{

#include <iostream>
#include <string>
#include <sstream>
#include <memory>
using namespace std;

#include "basalt.h"

#define YYDEBUG 1

namespace std {
template<typename T, typename... Args>
std::unique_ptr<T> make_unique(Args&&... args) {
    return std::unique_ptr<T>(new T(std::forward<Args>(args)...));
}
}


static AST::ExprList * ConcatExprLists(AST::ExprList * a, AST::ExprList * b)
{
  if (b == nullptr)
    return a;

  for (auto & r : *b) {
    if (r != nullptr)
      a->push_back(r);
  }

  return a;
}

template<class DefExprType, class RefExprType, class BinExprType>
static AST::ExprList * DefineVariable(AST::VariableDef::Type type,
                                      const std::string & name_, 
                                             const char * suffix,
                                              AST::Expr * expr)
{
  if (name_.length() > g_profile.m_identifierLen+1) {
    stringstream strm;
    strm << "identifier longer than maximum of " << g_profile.m_identifierLen;
    g_application.OnWarning(strm.str());
  }

  std::string name   (name_.substr(0, g_profile.m_identifierLen) + suffix);
  std::string defName(name_ + suffix);

  auto r = g_variables.find(name);
  if (r == g_variables.end()) {
    g_variables[name] = AST::VariableDef(type, name, defName);
  }
  else if (r->second.m_defName != defName) {
    stringstream strm;
    strm << "identifier first defined as " << r->second.m_defName << " now defined as " << defName;
    g_application.OnWarning(strm.str());
  }

  AST::ExprList * exprList = new AST::ExprList();

  exprList->push_back(
            new DefExprType(name, false)
              );

  exprList->push_back(
            new BinExprType('=', new RefExprType(name), expr)
               );

  return exprList;             
}


